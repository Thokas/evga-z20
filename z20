class Z20Error(Exception):
    pass


def find_keyboard():
    """hidraw node of the keyboard's configuration interface (USB interface 1), and the model."""
    for sysdir in sorted(glob.glob("/sys/class/hidraw/hidraw*")):
        try:
            with open(os.path.join(sysdir, "device/uevent")) as f:
                props = dict(line.rstrip("\n").split("=", 1) for line in f if "=" in line)
            with open(os.path.join(os.path.realpath(os.path.join(sysdir, "device")), "../bInterfaceNumber")) as f:
                interface = int(f.read(), 16)
            _bus, vendor, product = (int(x, 16) for x in props.get("HID_ID", "").split(":"))
        except (OSError, ValueError):
            continue
        if vendor == VENDOR and product in PRODUCTS and interface == 1:
            return "/dev/" + os.path.basename(sysdir), PRODUCTS[product]
    raise Z20Error("no EVGA Z20 connected")


def ioc(nr, size):
    return (3 << 30) | (size << 16) | (ord("H") << 8) | nr  # _IOC(_IOC_READ|_IOC_WRITE, 'H', nr, size)


def checksum(report):
    """Profiles and macros carry the negated sum of everything after the checksum byte."""
    return -sum(report[8:]) & 0xFF


def check_request(r):
    """Refuse anything but the commands this tool knows to be safe."""
    rid = r[0]
    ok = rid in SIZES and r[1:3] == HEADER
    if rid == 4:
        ok = ok and r[3] in GENERAL and (r[4] == READ or r[3] in GENERAL_WRITES)
        if r[3] == 0x07 and r[4] == WRITE:  # a key function in RAM: a layer, a key, not Fn
            ok = ok and r[5] in (0, 1) and r[7] in KEY_POSITIONS and r[7] != FN
        if r[3] == 0x0F and r[4] == WRITE:  # 6KRO (0) or NKRO (1)
            ok = ok and r[7] in (0, 1)
    elif rid == 8:
        ok = ok and (r[3] == READ or (r[3] == WRITE and 1 <= r[4] <= 9 and r[7] == checksum(r)))
    elif rid == 6:  # colors per LED: show them (with the checksum) or stop
        ok = ok and r[3] in (0, 1) and r[4:7] == b"\0\0\0" and r[7] == checksum(r)
    elif rid == 7 and r[3] == 0x1B:  # report rate: read (01), read the default (02), set (00)
        ok = ok and r[5] == 0 and (r[4] in (READ, 2) or r[4] == WRITE and r[8] in RATES.values() and r[7] == checksum(r))
    elif rid == 7:  # the active profile's lighting in RAM; the sensor (03-0A) and keys (0B) stay closed
        ok = (ok and RAM_EFFECT <= r[3] <= max(b for b, _, _ in RAM_BLOCKS.values()) and r[5] == 0
              and (r[4] == READ or r[4] == WRITE and r[7] == checksum(r)))
    elif rid == 9 and r[3] == WRITE:  # a macro: stored (status 1) or deleted (FF)
        ok = (ok and r[4] in MACRO_SLOTS and r[7] == checksum(r) and r[1031] in (1, 0xFF)
              and r[8] <= MACRO_NAME_MAX and r[62] | r[63] << 8 <= MACRO_DATA_MAX)
    else:
        ok = ok and r[3] == READ  # macro reads; macro names (report 10) are only read
    if not ok:
        raise Z20Error(f"refusing to send {bytes(r[:8]).hex(' ')}")


def check_answer(report, answer):
    """The keyboard has one answer per report ID: make sure this one is to our request."""
    if answer[1:3] != HEADER or answer[6] != SUCCESS:
        raise Z20Error(f"the keyboard refused {bytes(report[:8]).hex(' ')}: {bytes(answer[:8]).hex(' ')}")
    # A read's answer repeats bytes 3-4: command and READ (report 4), or READ and the
    # profile or macro number. Writes are checked by reading back.
    is_read = report[4] == READ if report[0] in (4, 7) else report[3] == READ
    if is_read and answer[3:5] != report[3:5]:
        raise Z20Error(f"answer to another request: {bytes(answer[:8]).hex(' ')} for {bytes(report[:8]).hex(' ')}")


class Keyboard:
    def __init__(self, lock=True):
        path, self.model = find_keyboard()
        try:
            self.fd = os.open(path, os.O_RDWR)
        except PermissionError:
            raise Z20Error(f"no access to {path}: install udev/70-evga-z20.rules") from None
        # One z20 at a time (a widget may poll while a command runs): the keyboard keeps a
        # single answer per report, which a second request in between would replace.
        if lock:
            fcntl.flock(self.fd, fcntl.LOCK_EX)
        self.changed = False  # previous/ is emptied before this run's first change
        self.relit = False  # the lighting in RAM changed: z20 backlight dims it once this run lets go

    def save_previous(self, reports):
        """Keep what a change replaces in previous/, which holds the last run's changes only:
        `z20 restore ~/.local/state/z20/previous` undoes them."""
        directory = os.path.join(STATE, "previous")
        if not self.changed:
            for old in glob.glob(os.path.join(directory, "*.bin")):
                os.remove(old)
            self.changed = True
        save(directory, reports)

    def close(self):
        os.close(self.fd)
        if self.relit:
            nudge_backlight()

    def call(self, request, wait):
        """Send a feature report, wait for the keyboard and return its answer in that report."""
        report = bytearray(request).ljust(SIZES[request[0]], b"\0")
        check_request(report)
        answer = bytearray(len(report))
        answer[0] = report[0]
        try:
            # A mutable buffer: an immutable one is copied into 1024 bytes, too few for reports 8 and 9.
            fcntl.ioctl(self.fd, ioc(0x06, len(report)), report, True)  # HIDIOCSFEATURE
            time.sleep(wait)
            fcntl.ioctl(self.fd, ioc(0x07, len(answer)), answer, True)  # HIDIOCGFEATURE
        except OSError as e:
            raise Z20Error(f"keyboard: {e.strerror} (unplugged?)") from None
        check_answer(report, answer)
        return bytes(answer)

    def send(self, request):
        """Send a feature report the keyboard takes without an answer (live lighting), as
        Unleash does: no read afterwards."""
        report = bytearray(request).ljust(SIZES[request[0]], b"\0")
        check_request(report)
        try:
            fcntl.ioctl(self.fd, ioc(0x06, len(report)), report, True)  # HIDIOCSFEATURE
        except OSError as e:
            raise Z20Error(f"keyboard: {e.strerror} (unplugged?)") from None
        # The end of the colors per LED (06 EA 02 00) puts the profile's lighting back: a moment for
        # that before the next report, also another z20 run's (the lock is held while this waits).
        # Once, the keyboard reset itself on lighting writes right after it (z20 light after animate).
        time.sleep(COLORS_END_S if report[:4] == bytes([6, *HEADER, 0]) else 0.005)

    def send_locked(self, request):
        """send() for a Keyboard opened with lock=False: holds the lock only while sending.
        Returns how long it waited for the lock (while another z20 run had the keyboard)."""
        start = time.monotonic()
        fcntl.flock(self.fd, fcntl.LOCK_EX)
        waited = time.monotonic() - start
        try:
            self.send(request)
        finally:
            fcntl.flock(self.fd, fcntl.LOCK_UN)
        return waited

    def read_ram(self, block):
        return self.call(bytes([7, *HEADER, block, READ]), 0.005)[8:]

    def write_ram(self, block, data):
        """Change a lighting block of the active profile in RAM and check it by reading it back."""
        report = bytearray(SIZES[7])
        report[:7] = bytes([7, *HEADER, block, WRITE, 0, 0])
        report[8:8 + len(data)] = data
        report[7] = checksum(report)
        self.send(report)
        self.relit = True
        if self.read_ram(block) != bytes(report[8:]):
            raise Z20Error(f"the lighting in RAM (block {block:02x}) reads back different; z20 light reload")

    def general(self, command, sub=READ, value=0, wait=0.005):
        if sub == WRITE and command in (0x06, 0x08):  # another profile, a reload: the lighting from flash
            self.relit = True
        return self.call(bytes([4, *HEADER, command, sub, 0, 0, value]), wait)

    def firmware(self):
        a = self.general(0x01, wait=0.01)
        return f"{a[8]}.{a[7]:02}"  # 26 01 is 1.38

    def profile_number(self):
        return self.general(0x06)[7]

    def set_profile(self, n):
        self.general(0x06, WRITE, n, wait=0.1)

    def game_mode(self):
        return bool(self.general(0x0B)[7])

    def set_game_mode(self, on):
        self.general(0x0B, WRITE, int(on), wait=0.1)

    def nkro(self):
        return bool(self.general(0x0F)[7])

    def set_nkro(self, on):
        self.general(0x0F, WRITE, int(on), wait=0.1)

    def distance(self):
        """What the presence sensor measures now: the distance in mm, as the keyboard smooths it
        (each measurement moves it an eighth of the way), and the keyboard's verdict on its last 8
        measurements, newest first: "near" (within the profile's distance), "far", or "nothing"
        (no echo: the distance then drifts toward a few cm, which means nothing). See in_view()."""
        a = self.general(0x41)
        return a[7] | a[8] << 8, [SEEN.get(b, str(b)) for b in a[9:17]]

    def read_profile(self, n):
        p = self.call(bytes([8, *HEADER, READ, n]), 0.02)
        if p[4] != n or p[7] != checksum(p):
            raise Z20Error(f"profile {n} came back damaged")
        return p

    def write_profile(self, n, profile):
        """Write a profile (as read, with changes), check it by reading it back and make
        the keyboard use it if it is the active one. The old one goes to previous/ first."""
        if len(profile) != SIZES[8] or profile[1:3] != HEADER:
            raise Z20Error(f"not a profile: {bytes(profile[:8]).hex(' ')}")
        old = self.read_profile(n)
        report = bytearray(profile)
        report[3], report[4] = WRITE, n
        report[7] = checksum(report)
        if report[8:] == old[8:]:
            return
        self.save_previous({f"profile-{n}": old})
        self.call(report, 0.1)
        if self.read_profile(n)[8:] != report[8:]:
            raise Z20Error(f"profile {n} reads back different from what was written; "
                           f"the old one is in {STATE}/previous (z20 restore {STATE}/previous)")
        if n == self.profile_number() and not self.update_ram(old, report):
            self.general(0x08, WRITE, wait=0.1)  # reload: as Unleash does after writing keys

    def update_ram(self, old, new):
        """Bring the active profile's RAM copy from old to new part by part: lighting blocks,
        sensor blocks, single key functions, each read back. A reload would restart the
        lighting effect, and one set to start on a key press stays dark until then. False
        (nothing sent) if something changed that has no part in RAM: then reload."""
        # Not the sensor's settings: whether their RAM copies (report 7 blocks 03-0A) reach the
        # sensor's logic is unclear, while a profile write and reload applies them and arms its
        # leave action again (checked), so a sensor change returns False here.
        parts = [(RAM_EFFECT, P_EFFECT, 2), *RAM_BLOCKS.values()]
        keys = [(layer, pos, base + pos * 4) for layer, base in ((0, P_KEYS), (1, P_FN_KEYS)) for pos in range(121)]
        covered = {i for _, at, size in parts for i in range(at, at + size)}
        covered |= {i for _, _, at in keys for i in range(at, at + 4)}
        covered |= set(range(P_NAME_LEN, P_NAME + 126)) | {P_GAME_KEYS, P_RATE}  # the name needs nothing
        changed_keys = [(layer, pos, at) for layer, pos, at in keys if old[at:at + 4] != new[at:at + 4]]
        if any(old[i] != new[i] for i in range(8, len(new)) if i not in covered) or \
                any(pos not in KEY_POSITIONS or pos == FN for _, pos, _ in changed_keys):
            return False
        for block, at, size in parts:
            if old[at:at + size] != new[at:at + size]:
                ram = bytearray(self.read_ram(block))
                ram[:size] = new[at:at + size]
                if block == RAM_EFFECT:  # as the keyboard does on loading: the effect's own direction
                    ram[1] = new[EFFECT_SUB[new[P_EFFECT]]] if new[P_EFFECT] in EFFECT_SUB else 0
                self.write_ram(block, ram)
        for layer, pos, at in changed_keys:
            self.call(bytes([4, *HEADER, 0x07, WRITE, layer, 0, pos, *new[at:at + 4]]), 0.005)
            if self.call(bytes([4, *HEADER, 0x07, READ, layer, 0, pos]), 0.005)[8:12] != new[at:at + 4]:
                raise Z20Error(f"key {KEY_POSITIONS[pos]} reads back different in RAM; z20 light reload")
        if old[P_GAME_KEYS] != new[P_GAME_KEYS]:  # in RAM as in the profile, inverted
            self.call(bytes([4, *HEADER, 0x0C, WRITE, 0, 0, new[P_GAME_KEYS]]), 0.005)
            if self.call(bytes([4, *HEADER, 0x0C, READ]), 0.005)[7] != new[P_GAME_KEYS]:
                raise Z20Error("the keys Game Mode blocks read back different in RAM; z20 light reload")
        if old[P_RATE] != new[P_RATE]:  # report 7 command 1B, as Unleash sets it
            report = bytearray(SIZES[7])
            report[:7] = bytes([7, *HEADER, 0x1B, WRITE, 0, 0])
            report[8] = new[P_RATE]
            report[7] = checksum(report)
            self.call(report, 0.005)
            if self.call(bytes([7, *HEADER, 0x1B, READ]), 0.005)[8] != new[P_RATE]:
                raise Z20Error("the report rate reads back different; z20 light reload")
        return True

    def macro_slots(self):
        table = self.call(bytes([9, *HEADER, READ, 0, 0, FAIL]), 0.15)
        return [i for i in range(1, 101) if table[7 + i] == 1]

    def macro_name(self, n):
        a = self.call(bytes([10, *HEADER, READ, n, 0, FAIL]), 0.01)
        return a[9:9 + min(a[8], 50)].decode("utf-8", "replace")

    def read_macro(self, n):
        return self.call(bytes([9, *HEADER, READ, n, 0, FAIL]), 0.15)

    def write_macro(self, n, name, data):
        """Store a macro in slot n as Unleash does (run mode, repeat count and time unit
        stay 0: the key decides how it runs) and check it by reading it back."""
        raw = name.encode()
        report = bytearray(SIZES[9])
        report[:7] = bytes([9, *HEADER, WRITE, n, 0, FAIL])
        report[8], report[9:9 + len(raw)] = len(raw), raw
        report[62:64] = len(data).to_bytes(2, "little")
        report[64:64 + len(data)] = data
        report[1031] = 1  # in use
        self.put_macro(n, report)

    def delete_macro(self, n):
        report = bytearray(SIZES[9])
        report[:7] = bytes([9, *HEADER, WRITE, n, 0, FAIL])
        report[1031] = 0xFF  # free; name and data lengths 0
        self.put_macro(n, report)

    def put_macro(self, n, report):
        """Send a macro report (to store or delete), the old macro saved to previous/ first."""
        report[3], report[4], report[6] = WRITE, n, FAIL
        report[7] = checksum(report)
        if n in self.macro_slots():
            self.save_previous({f"macro-{n:03}": self.read_macro(n)})
        self.call(report, 0.15)
        if report[1031] == 0xFF:
            if n in self.macro_slots():
                raise Z20Error(f"macro {n} is still there after deleting it")
        elif self.read_macro(n)[7:] != report[7:]:
            raise Z20Error(f"macro {n} reads back different from what was written; "
                           f"the old one is in {STATE}/previous (z20 restore {STATE}/previous)")


def save(directory, reports):
    """Only for the user: macros can hold anything that was typed while recording them."""
    os.makedirs(directory, mode=0o700, exist_ok=True)
    for d in (STATE, os.path.dirname(directory), directory):
        if d.startswith(STATE):
            os.chmod(d, 0o700)
    for name, data in reports.items():
        path = os.path.join(directory, f"{name}.bin")
        with open(os.open(path, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600), "wb") as f:
            os.fchmod(f.fileno(), 0o600)
            f.write(data)


def key_name(code):
    return MODIFIERS[code - 0x70] if 0x70 <= code <= 0x77 else HID_KEYS.get(code, f"key 0x{code:02x}")


def key_function(b, macro_names):
    """Text and JSON for a key's 4-byte function (function, parameter 1-3)."""
    func, p1, p2, p3 = b
    if func == 0:
        keys = [MODIFIERS[i] for i in range(8) if p1 & (1 << i)] + [HID_KEYS.get(k, f"0x{k:02x}") for k in (p2, p3) if k]
        return "key " + "+".join(keys or ["none"]), {"function": "key", "keys": keys}
    if func == 2:
        usage = p1 | p2 << 8
        return f"media {CONSUMER.get(usage, f'0x{usage:03x}')}", {"function": "media", "usage": usage}
    if func == 3:
        name = macro_names.get(p1, "")
        # parameter 3 of mode 11 (Unleash's "repeat") counts the runs after the first
        run = f"{p3 + 1} times" if p2 == 11 else RUN_MODES.get(p2, f"run mode {p2}")
        text = f"macro {p1}" + (f' "{name}"' if name else "") + f" ({run})"
        return text, {"function": "macro", "macro": p1, "name": name, "run": run}
    if func == 6:
        text = "wheel " + ("up" if p1 == 0 else "down")
        return text, {"function": "wheel", "text": text}
    text = FUNCTIONS.get(func, f"function {func} ({p1} {p2} {p3})")
    return text, {"function": text}


def parse_function(words, macro_slots, run):
    """The 4-byte key function for `z20 key KEY WORDS`; run is (mode, count) for a macro."""
    what, rest = words[0], words[1:]
    one = rest[0].lower() if len(rest) == 1 else None
    if what == "macro":
        if not (one and one.isdigit() and int(one) in macro_slots):
            raise Z20Error(f"no macro {' '.join(rest)} on the keyboard (z20 macros lists them)")
        return bytes([3, int(one), *run])
    if what == "key" and one:
        mods, keys = 0, []
        for part in one.split("+"):
            if part in MODIFIER_BITS:
                mods |= MODIFIER_BITS[part]
            elif part in KEY_USAGES:
                keys.append(KEY_USAGES[part])
            else:
                raise Z20Error(f"unknown key: {part}")
        if len(keys) > 2:
            raise Z20Error("key: modifiers and at most two keys, like ctrl+shift+t")
        return bytes([0, mods, *(keys + [0, 0])[:2]])
    if what == "media" and one in MEDIA:
        return bytes([2, MEDIA[one] & 0xFF, MEDIA[one] >> 8, 0])
    if what == "click" and one in ("left", "right", "middle"):
        return bytes([{"left": 7, "right": 8, "middle": 9}[one], 0, 0, 0])
    if what == "wheel" and one in ("up", "down"):
        return bytes([6, int(one == "down"), 0, 0])
    if what == "profile" and one and re.fullmatch(r"[1-9]|next|previous", one):
        return bytes([30 if one == "next" else 31 if one == "previous" else 16 + int(one), 0, 0, 0])
    if what == "off" and not rest:
        return bytes([0xFF, 0, 0, 0])  # as Unleash writes "disabled"
    raise Z20Error(f"unknown key function: {' '.join(words)}")


def key_target(name, fn):
    """The position of the key `z20 key` names, if that key (or its Fn layer) may change."""
    pos = KEY_BY_NAME.get(name.lower())
    if pos is None:
        raise Z20Error(f"no key {name} (names as on a US keyboard: a, f1, capslock, comma, e1, game ...)")
    if pos == FN:
        raise Z20Error("Fn stays Fn: the keyboard's own Fn shortcuts (profiles, brightness, recording) need it")
    if fn and pos in FN_RESERVED:
        raise Z20Error(f"Fn+{KEY_POSITIONS[pos]} is one of the keyboard's own shortcuts")
    return pos


def reset_keys(profile, factory):
    """The profile with every key function as in the factory profile, but for Win and Fn."""
    p = bytearray(profile)
    for base in (P_KEYS, P_FN_KEYS):
        keep = {pos: p[base + pos * 4:base + pos * 4 + 4] for pos in KEEP_ON_RESET}
        p[base:base + 121 * 4] = factory[base:base + 121 * 4]
        for pos, function in keep.items():
            p[base + pos * 4:base + pos * 4 + 4] = function
    return p


def changed_keys(profile, factory, skip=()):
    """(label, 4-byte function) of the keys whose function differs from the factory setting."""
    out = []
    for pos, name in KEY_POSITIONS.items():
        for prefix, base in (("", P_KEYS), ("Fn+", P_FN_KEYS)):
            at = base + pos * 4
            if pos not in skip and profile[at:at + 4] != factory[at:at + 4]:
                out.append((prefix + name, profile[at:at + 4]))
    return out


def parse_steps(text):
    """Macro data from steps as `z20 macros` prints them, like "LShift down, W, wait 20 ms,
    LShift up". A key, click ("left click") or media key without down / up is pressed and
    let go; "wait N" (ms) takes half milliseconds.

    Every step gets a wait before it, 2.5 ms where none is given, as Unleash writes them:
    the keyboard reports its keys at a fixed rate, and steps within one report merge (a key
    pressed and let go without a wait never shows)."""
    data = bytearray()
    waited = False

    def step_bytes(b):
        nonlocal waited
        if not waited:
            data.extend(MACRO_GAP)
        data.extend(b)
        waited = False

    for step in (s.strip() for s in text.split(",")):
        words = step.lower().split()
        if not words:
            raise Z20Error(f"empty step in: {text}")
        if words[0] == "wait" and len(words) in (2, 3) and words[2:] in ([], ["ms"]):
            try:
                half = round(float(words[1]) * 2)  # stored as half milliseconds - 1
            except ValueError:
                half = 0
            if not 1 <= half <= 1_200_000:
                raise Z20Error(f"not a wait of 0.5 ms to 10 minutes: {step}")
            while half:
                part = min(half, 0x10000)
                data += bytes([0x01, (part - 1) & 0xFF, (part - 1) >> 8])
                half -= part
            waited = True
            continue
        if words[:2] == ["mouse", "to"] and len(words) == 4 and all(w.isdigit() and int(w) < 0x10000 for w in words[2:]):
            x, y = int(words[2]), int(words[3])
            step_bytes(bytes([0x80, x & 0xFF, x >> 8, y & 0xFF, y >> 8]))
            continue
        if words[-1] in ("down", "up") and len(words) > 1:
            name, presses = " ".join(words[:-1]), [words[-1] == "up"]
        else:
            name, presses = " ".join(words), [False, True]  # press and let go
        if name in ("left click", "right click", "middle click") and len(presses) == 2:
            name = name.split()[0] + " button"
        for up in presses:
            if name == "wheel" and len(presses) == 1:
                step_bytes([0xF8 if up else 0x78])  # "wheel up" / "wheel down" scroll
            elif name.endswith(" button") and name.split()[0] in BUTTONS and len(name.split()) == 2:
                step_bytes([BUTTONS[name.split()[0]] | (0x80 if up else 0)])
            elif name in MEDIA or re.fullmatch(r"media 0x[0-9a-f]{1,3}", name) or name == "media" and up:
                usage = 0 if up else MEDIA.get(name) or int(name.split()[-1], 16)
                step_bytes([0x03, usage & 0xFF, usage >> 8])
            elif name in MACRO_KEYS or re.fullmatch(r"key 0x(0[4-9a-f]|[1-6][0-9a-f]|7[0-7])", name):
                code = MACRO_KEYS.get(name) or int(name.split()[-1], 16)
                step_bytes([code | (0x80 if up else 0)])
            else:
                raise Z20Error(f"unknown macro step: {step}")
    if not data:
        raise Z20Error("a macro needs at least one step")
    if len(data) > MACRO_DATA_MAX:
        raise Z20Error(f"macro too long: {len(data)} bytes, the keyboard keeps {MACRO_DATA_MAX}")
    return bytes(data)


def macro_actions(data):
    """The steps of a macro's data: waits, keys and mouse buttons down / up, and so on."""
    out, i = [], 0
    data = bytes(data) + b"\0" * 4  # a cut-off last step decodes as zeros instead of failing
    while i < len(data) - 4:
        b = data[i]
        if b == 0x01:
            out.append(f"wait {((data[i + 1] | data[i + 2] << 8) + 1) / 2:g} ms")  # half milliseconds - 1
            i += 3
        elif b == 0x03:
            usage = data[i + 1] | data[i + 2] << 8
            out.append(f"{CONSUMER.get(usage, f'media 0x{usage:03x}')} down" if usage else "media up")
            i += 3
        elif b == 0x80:
            out.append(f"mouse to {data[i + 1] | data[i + 2] << 8} {data[i + 3] | data[i + 4] << 8}")
            i += 5
        elif b & 0x7F == 0x78:
            out.append("wheel " + ("up" if b & 0x80 else "down"))
            i += 1
        else:  # a key or mouse button, 0x80 set when it goes up
            button = {0x7A: "left button", 0x7B: "right button", 0x7C: "middle button"}.get(b & 0x7F)
            out.append(f"{button or key_name(b & 0x7F)} {'up' if b & 0x80 else 'down'}")
            i += 1
    return out


def color_hex(argb):
    return "#" + bytes(argb[1:4]).hex()


def lighting(p):
    effect = p[P_EFFECT]
    state = {"effect": EFFECT_NAMES.get(effect, f"effect {effect}")}
    if effect in (1, 2, 16):  # one or two colors worth showing; the others have 7-8 each
        offset, count, size = EFFECT_COLORS[effect]
        start = offset + size - 4
        state["colors"] = [color_hex(p[start + i * size:start + i * size + 4]) for i in range(count)]
    if effect in EFFECT_CYCLE:
        state["cycle_ms"] = p[EFFECT_CYCLE[effect]] | p[EFFECT_CYCLE[effect] + 1] << 8
    if effect == 6:
        state["brightness"] = round(p[P_STARS_BRIGHTNESS] * 100 / 255)
    elif effect in EFFECT_COLORS:  # the brightness byte of the effect's first color
        offset, _, size = EFFECT_COLORS[effect]
        state["brightness"] = round(p[offset + size - 4] * 100 / 255)
    return state


def lighting_text(state):
    return " ".join([state["effect"], *state.get("colors", []),
                     *([f"{state['cycle_ms']} ms"] if "cycle_ms" in state else [])])


def parse_color(text):
    if not re.fullmatch(r"#?[0-9a-fA-F]{6}", text):
        raise Z20Error(f"not a color: {text} (rrggbb or #rrggbb)")
    return bytes.fromhex(text.lstrip("#"))


def fill_colors(effect, colors):
    """The colors for an effect: breathing out to dark from one color; the animated effects'
    7-8 colors repeated from the ones given."""
    count = EFFECT_COLORS.get(EFFECTS[effect], (0, 0, 0))[1]
    if effect == "breathing" and len(colors) == 1:
        return colors + [b"\0\0\0"]
    if count > 2 and 0 < len(colors) < count:
        return (colors * count)[:count]
    return colors


def set_lighting(p, effect, colors, brightness, cycle, direction=None):
    """The profile with another effect (and colors, brightness, cycle, direction); everything
    else as it was. Colors not given stay as the profile keeps them."""
    p = bytearray(p)
    p[P_EFFECT] = EFFECTS[effect]
    mode = EFFECTS[effect]
    if direction is not None:
        p[EFFECT_SUB[mode]] = DIRECTIONS[mode][direction]
    p[P_EFFECT + 1] = p[EFFECT_SUB[mode]] if mode in EFFECT_SUB else 0
    if mode in EFFECT_COLORS:
        offset, count, size = EFFECT_COLORS[mode]
        for i in range(count):
            c = offset + i * size + size - 4  # brightness, red, green, blue
            if i < len(colors):
                p[c + 1:c + 4] = colors[i]
            if brightness is not None:
                p[c] = round(brightness * 255 / 100)
    if mode == 6 and brightness is not None:
        p[P_STARS_BRIGHTNESS] = round(brightness * 255 / 100)
    if cycle is not None and mode in EFFECT_CYCLE:
        p[EFFECT_CYCLE[mode]:EFFECT_CYCLE[mode] + 2] = max(100, min(60000, cycle)).to_bytes(2, "little")
    return p


def sensor_settings(p):
    u16 = lambda o: p[P_SENSOR + o] | p[P_SENSOR + o + 1] << 8
    name = lambda table, value, extra: {v: k for k, v in table.items()}.get(value, extra.get(value, str(value)))
    return {"on": bool(p[P_SENSOR]), "distance_cm": u16(1) / 10,
            "come": name(COME, u16(5), {0: "turn on"}), "come_after_s": u16(3) / 1000,
            "leave": name(LEAVE, u16(9), {0: "turn off"}), "leave_after_s": u16(7),
            "welcome": EFFECT_NAMES.get(p[P_SENSOR + 27], str(p[P_SENSOR + 27])), "welcome_ms": u16(29)}


def sensor_text(s):
    if not s["on"]:
        return "presence sensor off"
    come = f"come: {s['come']}" + (f" after {s['come_after_s']:g} s" if s["come_after_s"] else "")
    return (f"present within {s['distance_cm']:g} cm; {come}, welcome {s['welcome']} {s['welcome_ms']} ms; "
            f"leave: {s['leave']} after {s['leave_after_s']} s")


def set_sensor(p, words):
    """The profile with one sensor setting changed: on | off | distance CM | come ACTION [S] |
    leave ACTION [S] | welcome EFFECT [MS]."""
    p = bytearray(p)

    def put(offset, value):
        p[P_SENSOR + offset:P_SENSOR + offset + 2] = value.to_bytes(2, "little")

    def number(text, low, high, what):
        try:
            value = float(text)
        except ValueError:
            value = low - 1
        if not low <= value <= high:
            raise Z20Error(f"{what}: {low:g} to {high:g}")
        return value

    what, rest = words[0], words[1:]
    if what in ("on", "off") and not rest:
        p[P_SENSOR] = int(what == "on")
    elif what == "distance" and len(rest) == 1:
        put(1, round(number(rest[0], 10, 120, "distance in cm") * 10))
    elif what == "come" and 1 <= len(rest) <= 2 and rest[0] in COME:
        put(5, COME[rest[0]])
        if rest[1:]:
            put(3, round(number(rest[1], 0, 10, "come after, seconds") * 1000))
    elif what == "leave" and 1 <= len(rest) <= 2 and rest[0] in LEAVE:
        put(9, LEAVE[rest[0]])
        if rest[1:]:
            put(7, round(number(rest[1], 10, 999, "leave after, seconds")))
    elif what == "welcome" and 1 <= len(rest) <= 2 and rest[0] in WELCOME:
        p[P_SENSOR + 27:P_SENSOR + 29] = bytes([WELCOME[rest[0]], 0])
        if rest[1:]:
            put(29, round(number(rest[1], 500, 30000, "welcome length, ms")))
    else:
        raise Z20Error("sensor: on | off | distance CM | come nothing|wake|unlock [S] | "
                       "leave nothing|dark|lock|sleep [S] | welcome " + "|".join(WELCOME) + " [MS]")
    return p


def interface_event(data):
    """Text for an input report on interface 1 (the sensor's actions may send some)."""
    if data[:1] == b"\x03" and len(data) > 2:
        what = STATUS_EVENTS.get(data[1], f"status 0x{data[1]:02x}")
        return f"keyboard: {what} {data[2]}" + (f" ({data[2:].hex(' ')})" if any(data[3:]) else "")
    if data[:1] == b"\x02" and len(data) > 2:
        usage = data[1] | data[2] << 8
        return "media key " + (CONSUMER.get(usage, f"0x{usage:03x}") if usage else "up")
    return f"report {data.hex(' ')}"


def in_view(seen):
    """Whether the sensor sees something, from the keyboard's verdicts (Keyboard.distance): at least
    two of the last 8 measurements had an echo. Someone sitting there can leave two in three without
    one (a weak echo); leaning back out of the beam, or a desk with nothing in front, leaves at most
    one. Near or far then goes by the newest echo (newest_echo)."""
    return sum(s != "nothing" for s in seen) >= 2


def newest_echo(seen):
    return next((s for s in seen if s != "nothing"), "nothing")


def watch_sensor(as_json):
    """Print the distance and presence as they change, and what the keyboard sends on
    interface 1, until Ctrl+C."""
    path, _ = find_keyboard()
    kb = Keyboard()
    threshold = sensor_settings(kb.read_profile(kb.profile_number()))["distance_cm"] * 10
    kb.close()
    events = os.open(path, os.O_RDONLY | os.O_NONBLOCK)  # input reports; no lock needed to read them
    last_shown, present = None, "?"  # nothing shown yet
    try:
        while True:
            kb = Keyboard()  # locked only while reading, so other z20 runs go on
            d, seen = kb.distance()
            kb.close()
            now = (d < threshold) if in_view(seen) else None  # None: nothing in view
            if now != present or now is not None and abs(d - last_shown) >= 50:
                state = {"distance_mm": d, "in_view": now is not None, "present": now}
                print(json.dumps(state) if as_json else f"{time.strftime('%H:%M:%S')}  " + (
                      f"{d:5d} mm  {'present' if now else 'away'}" if now is not None
                      else "nothing in view (leaning back, or nobody)"), flush=True)
                last_shown, present = d, now
            while select.select([events], [], [], 0)[0]:
                text = interface_event(os.read(events, 64))
                print(json.dumps({"event": text}) if as_json else f"{time.strftime('%H:%M:%S')}  {text}", flush=True)
            time.sleep(0.5)
    except KeyboardInterrupt:
        pass
    finally:
        os.close(events)


PRESENCE_CONFIG = os.path.expanduser("~/.config/z20/presence.ini")
PRESENCE_ACTIONS = ("lock", "screen-off", "wake", "pause-media", "resume-media")
PRESENCE_DEFAULTS = {"leave after": "30", "come after": "1", "leave": "pause-media", "come": "wake, resume-media",
                     "leave run": "", "come run": "", "distance": "", "away light": ""}


def presence_config(path=PRESENCE_CONFIG, text=None):
    """The [presence] section of the config file (or of text, as it would be), with defaults for
    what it leaves out."""
    parser = configparser.ConfigParser(defaults=PRESENCE_DEFAULTS, interpolation=None)
    parser.read_dict({"presence": {}})
    try:
        parser.read(path) if text is None else parser.read_string(text, path)
    except configparser.Error as e:
        raise Z20Error(f"{path}: {e}") from None
    section = parser["presence"]
    cfg = {}
    try:
        cfg["leave_after"] = float(section["leave after"])
        cfg["come_after"] = float(section["come after"])
        cfg["distance_mm"] = round(float(section["distance"]) * 10) if section["distance"] else None
    except ValueError as e:
        raise Z20Error(f"{path}: {e}") from None
    for event in ("leave", "come"):
        cfg[event] = []  # (action, seconds after the event)
        for item in (a.strip() for a in section[event].split(",") if a.strip()):
            found = re.fullmatch(r"([a-z-]+)(?:\s+after\s+(\d+(?:\.\d+)?)\s*s?)?", item)
            if not found or found.group(1) not in PRESENCE_ACTIONS:
                raise Z20Error(f"{path}: {event}: not an action: {item} "
                               f"(known: {', '.join(PRESENCE_ACTIONS)}, each with an optional 'after SECONDS')")
            cfg[event].append((found.group(1), float(found.group(2) or 0)))
        cfg[f"{event}_run"] = section[f"{event} run"]
    # The lighting while away: what follows z20 in "z20 light EFFECT ..." or "z20 animate EFFECT ...".
    try:
        cfg["away_light"] = shlex.split(section["away light"])
    except ValueError as e:
        raise Z20Error(f"{path}: away light: {e}") from None
    light = cfg["away_light"]
    if light and not (len(light) > 1 and (light[0] == "light" and light[1] in EFFECTS
                                          or light[0] == "animate" and light[1] in ANIMATIONS)
                      and not {"--live", "--save", "--profile"} & set(light)):
        raise Z20Error(f"{path}: away light: not a lighting: {section['away light']} (light EFFECT ... or "
                       f"animate EFFECT ..., as for z20, without --live or --save)")
    return cfg


def set_presence(changes, path=PRESENCE_CONFIG):
    """Change settings of presence.ini's [presence] section, [(key, value)] with the keys of
    PRESENCE_DEFAULTS, and keep the rest of the file (comments, other settings) as it is. An
    empty value stays in the file: "leave =" means nothing, while no "leave" means the default."""
    os.makedirs(os.path.dirname(path), exist_ok=True)
    lock = os.open(os.path.dirname(path), os.O_RDONLY)
    try:
        fcntl.flock(lock, fcntl.LOCK_EX)  # one change at a time, each on top of the last
        _set_presence(changes, path)
    finally:
        os.close(lock)


def _set_presence(changes, path):
    try:
        with open(path) as f:
            lines = f.read().splitlines()
    except FileNotFoundError:
        lines = []
    header = lambda line: re.fullmatch(r"\s*\[([^]]*)\]\s*", line)
    start = next((i for i, line in enumerate(lines) if header(line) and header(line).group(1).strip() == "presence"),
                 None)
    if start is None:
        lines += [""] * bool(lines) + ["[presence]"]
        start = len(lines) - 1
    for key, value in changes:
        if key not in PRESENCE_DEFAULTS:
            raise Z20Error(f"presence set: no setting '{key}' (settings: {', '.join(PRESENCE_DEFAULTS)})")
        if "\n" in value:
            raise Z20Error(f"presence set: {key}: one line only")
        end = next((i for i in range(start + 1, len(lines)) if header(lines[i])), len(lines))
        at = next((i for i in range(start + 1, end) if re.match(rf"\s*{re.escape(key)}\s*[=:]", lines[i], re.I)),
                  None)
        if at is None:  # a new line at the end of the section, before the blank lines that close it
            at = end
            while at > start + 1 and not lines[at - 1].strip():
                at -= 1
            lines.insert(at, "")
        else:
            while at + 1 < end and lines[at + 1][:1].isspace() and lines[at + 1].strip()[:1] not in ("", "#", ";"):
                del lines[at + 1]  # its value's continuation lines
                end -= 1
        lines[at] = f"{key} = {value.strip()}".rstrip()
    text = "\n".join(lines) + "\n"
    presence_config(path, text)  # raises before anything is written
    with open(path, "w") as f:  # in place: a symlinked file stays one
        f.write(text)


class Presence:
    """Decides from the distance readings when someone left (away for leave_after seconds)
    and came back (near again for come_after seconds). Starts as present."""

    def __init__(self, leave_after, come_after):
        self.leave_after, self.come_after = leave_after, come_after
        self.present, self.since = True, None  # since: when the readings began to disagree

    def update(self, near, now):
        """near: someone within the distance. Returns "leave", "come" or None."""
        if near == self.present:
            self.since = None
            return None
        if self.since is None:
            self.since = now
        if now - self.since >= (self.leave_after if self.present else self.come_after):
            self.present, self.since = near, None
            return "come" if near else "leave"
        return None


class Pending:
    """Actions due some seconds after the last event; the next event drops what is left."""

    def __init__(self):
        self.items = []

    def set(self, actions, now):
        self.items = [(now + delay, action) for action, delay in actions]

    def due(self, now):
        ready = [action for when, action in self.items if when <= now]
        self.items = [(when, action) for when, action in self.items if when > now]
        return ready


class Desktop:
    """What z20 presence does on the desktop, with standard tools: loginctl (systemd), busctl
    (D-Bus: media players over MPRIS, the screen saver) and kscreen-doctor (KDE)."""

    MPRIS = ("/org/mpris/MediaPlayer2", "org.mpris.MediaPlayer2.Player")

    def __init__(self, dry_run=False):
        self.dry_run, self.paused = dry_run, []

    def log(self, text):
        print(f"{time.strftime('%H:%M:%S')}  {text}", flush=True)

    def query(self, *args):
        try:
            return subprocess.run(["busctl", "--user", *args], capture_output=True, text=True, timeout=5).stdout
        except (OSError, subprocess.TimeoutExpired):
            return ""

    def act(self, argv):
        if self.dry_run:
            self.log("would run: " + " ".join(shlex.quote(a) for a in argv))
            return
        try:
            done = subprocess.run(argv, capture_output=True, text=True, timeout=30)
            if done.returncode:
                self.log(f"{argv[0]} failed: {(done.stderr or done.stdout).strip()[:200]}")
        except (OSError, subprocess.TimeoutExpired) as e:
            self.log(f"{argv[0]}: {e}")

    def players(self):
        names = shlex.split(self.query("call", "org.freedesktop.DBus", "/", "org.freedesktop.DBus", "ListNames"))
        return [n for n in names[2:] if n.startswith("org.mpris.MediaPlayer2.")]

    def playing(self, player):
        return shlex.split(self.query("get-property", player, *self.MPRIS, "PlaybackStatus"))[1:] == ["Playing"]

    def do(self, action):
        """Carry out one action and log what it did."""
        if action == "lock":
            self.act(["loginctl", "lock-session"])
        elif action == "screen-off":
            self.act(["kscreen-doctor", "--dpms", "off"])
        elif action == "wake":
            self.act(["busctl", "--user", "call", "org.freedesktop.ScreenSaver", "/ScreenSaver",
                      "org.freedesktop.ScreenSaver", "SimulateUserActivity"])
            self.act(["kscreen-doctor", "--dpms", "on"])
        elif action == "pause-media":  # and remember who played, for resume-media
            self.paused = [p for p in self.players() if self.playing(p)]
            for player in self.paused:
                self.act(["busctl", "--user", "call", player, *self.MPRIS, "Pause"])
        elif action == "resume-media":  # only what pause-media paused, if it is still there
            resume = sorted(set(self.paused) & set(self.players()))
            for player in resume:
                self.act(["busctl", "--user", "call", player, *self.MPRIS, "Play"])
            self.paused = []
        names = lambda players: ", ".join(p.split(".", 3)[3] for p in players) or "nothing"
        detail = {"pause-media": lambda: f"paused {names(self.paused)}",
                  "resume-media": lambda: f"resumed {names(resume)}"}.get(action)
        self.log(f"  {action}" + (f": {detail()}" if detail else ""))

    def run(self, command):
        self.act(["sh", "-c", command])

    def z20(self, *args):
        self.act([sys.executable, os.path.realpath(__file__), *args])

    def away_light(self, args):
        """The lighting while away, for now (--live): the stored one comes back with lighting_back()."""
        if args[0] == "light":
            self.z20("animate", "off", "--live")  # a software effect would cover the keyboard's own
        self.z20(*args, "--live")
        self.log(f"  away light: {shlex.join(args)}")

    def lighting_back(self):
        self.z20("animate", "reload")
        self.z20("light", "reload")
        self.log("  lighting back")


def presence(dry_run):
    """Watch the sensor and run the configured actions when someone leaves and comes back,
    until stopped. Survives the keyboard being unplugged or the computer sleeping."""
    cfg = presence_config()
    desktop = Desktop(dry_run)
    tracker = Presence(cfg["leave_after"], cfg["come_after"])
    pending = Pending()
    threshold, checked = cfg["distance_mm"], float("-inf")  # the profile's distance from the first reading on
    actions = lambda event: ", ".join(a + (f" after {d:g} s" if d else "") for a, d in cfg[event]) or "-"
    desktop.log(f"presence: leave after {cfg['leave_after']:g} s: {actions('leave')}"
                f"{'; ' + cfg['leave_run'] if cfg['leave_run'] else ''}"
                f"{'; away light: ' + shlex.join(cfg['away_light']) if cfg['away_light'] else ''}; "
                f"come after {cfg['come_after']:g} s: {actions('come')}"
                f"{'; ' + cfg['come_run'] if cfg['come_run'] else ''}"
                f"{' (dry run)' if dry_run else ''}; config {PRESENCE_CONFIG}"
                f"{'' if os.path.exists(PRESENCE_CONFIG) else ' (not there: defaults)'}")

    def stop(_signum, _frame):
        raise KeyboardInterrupt
    signal.signal(signal.SIGTERM, stop)
    # lit: the away light shows; viewing: the sensor sees something; settled: from when the distance counts
    trouble, recent, lit, viewing, settled = None, [], False, True, 0.0
    try:
        while True:
            try:
                kb = Keyboard()  # locked only while reading, so other z20 runs go on
                try:
                    if cfg["distance_mm"] is None and time.monotonic() - checked > 60:  # follow profile changes
                        threshold = sensor_settings(kb.read_profile(kb.profile_number()))["distance_cm"] * 10
                        checked = time.monotonic()
                    d, seen = kb.distance()
                finally:
                    kb.close()
            except Z20Error as e:
                if str(e) != trouble:
                    desktop.log(f"waiting for the keyboard: {e}")
                    trouble = str(e)
                time.sleep(5)
                continue
            if trouble:
                desktop.log("keyboard back")
                trouble = None
            now = time.monotonic()
            event = None
            if not in_view(seen):
                if viewing:  # leaned back out of the beam, or gone with nothing in front: no telling which
                    desktop.log(f"nothing in view: {'present' if tracker.present else 'away'} until the sensor "
                                f"sees something again")
                    viewing, recent = False, []
            else:
                if not viewing:
                    desktop.log(f"in view again: {d} mm")
                    viewing, settled = True, now + 3  # the smoothed distance climbs back from a few cm
                # Near or not, for each reading of the last 2.5 s; most of them decide (single ones jump
                # around). With the profile's distance, the keyboard's verdict says it at once.
                if cfg["distance_mm"] is None:
                    recent = (recent + [newest_echo(seen) == "near"])[-5:]
                elif now >= settled:
                    recent = (recent + [d < threshold])[-5:]
                if recent:
                    event = tracker.update(sorted(recent)[len(recent) // 2], now)
            if event:
                desktop.log(f"{'left' if event == 'leave' else 'back'}: {d} mm "
                            f"(present within {threshold / 10:g} cm)")
                pending.set(cfg[event], now)  # coming back drops what leaving left pending, and the other way round
                if event == "leave" and cfg["away_light"]:
                    desktop.away_light(cfg["away_light"])
                    lit = True
                elif event == "come" and lit:
                    desktop.lighting_back()
                    lit = False
                if cfg[f"{event}_run"]:
                    desktop.run(cfg[f"{event}_run"])
            for action in pending.due(now):
                desktop.do(action)
            time.sleep(0.5)
    finally:
        signal.signal(signal.SIGTERM, signal.SIG_DFL)
        if lit:  # stopped (or logged out) while away
            desktop.lighting_back()


def with_ram_lighting(kb, p, effect):
    """The stored profile p with the lighting in RAM over it: the effect number and the
    settings of `effect` (a number), as far as the RAM has them, without z20 backlight's dimming."""
    p = bytearray(p)
    p[P_EFFECT:P_EFFECT + 2] = kb.read_ram(RAM_EFFECT)[:2]
    if effect in RAM_BLOCKS:
        block, at, size = RAM_BLOCKS[effect]
        ram = kb.read_ram(block)[:size]
        state = backlight_state()
        if state and state["effect"] == effect and state["shown"] == ram.hex():
            ram = bytes.fromhex(state["block"])  # as it is set
        p[at:at + size] = ram
    return p


def live_lighting(kb, effect, colors, brightness, cycle, direction=None):
    """Change the active profile's lighting in RAM only: shown at once, gone on reload."""
    stored = kb.read_profile(kb.profile_number())
    mode = EFFECTS[effect]
    before = with_ram_lighting(kb, stored, mode)
    after = set_lighting(before, effect, colors, brightness, cycle, direction)
    if mode in RAM_BLOCKS:
        block, at, size = RAM_BLOCKS[mode]
        ram = bytearray(kb.read_ram(block))
        ram[:size] = after[at:at + size]
        kb.write_ram(block, ram)
    ram = bytearray(kb.read_ram(RAM_EFFECT))
    ram[:2] = after[P_EFFECT:P_EFFECT + 2]
    kb.write_ram(RAM_EFFECT, ram)
    return after


def led_targets(text):
    """LED positions from a comma list of LED names (keys, LeftBar1-9, RightBar1-9, Logo1-4)
    and groups (all, keys, bars, leftbar, rightbar, logo)."""
    by_name = {**KEY_BY_NAME, **{name.lower(): pos for pos, name in LED_NAMES.items()}}
    out = []
    for part in (s.strip().lower() for s in text.split(",")):
        if part in LED_GROUPS:
            out += LED_GROUPS[part]
        elif part in by_name:
            out.append(by_name[part])
        else:
            raise Z20Error(f"no LED {part} (key names, LeftBar1-9, RightBar1-9, Logo1-4, or all, keys, bars, logo)")
    return out


def color_frame(frame, pairs, brightness):
    """The LED frame (196 x brightness, red, green, blue) with LEDS COLOR pairs applied."""
    frame = bytearray(frame or bytes(LED_COUNT * 4))
    level = 0xFF if brightness is None else round(brightness * 255 / 100)
    for leds, color in pairs:
        for pos in led_targets(leds):
            frame[pos * 4:pos * 4 + 4] = bytes([level, *parse_color(color)])
    return frame


def dimmed_frame(frame, percent):
    """The LED frame with every brightness at percent of its own."""
    frame = bytearray(frame)
    frame[0::4] = bytes(round(b * percent / 100) for b in frame[0::4])
    return frame


def color_report(frame):
    report = bytearray(SIZES[6])
    report[:4] = bytes([6, *HEADER, 1])  # 1: show these colors
    report[8:8 + len(frame)] = frame
    report[7] = checksum(report)
    return report


def colors_shown(frame):
    """{"#rrggbb": [LED names]} of the LEDs that aren't dark."""
    out = {}
    for pos, name in LED_NAMES.items():
        argb = frame[pos * 4:pos * 4 + 4]
        if any(argb[1:]) and argb[0]:
            out.setdefault(color_hex(argb), []).append(name)
    return out


# Software effects (z20 animate): z20 works out every LED's color and sends a frame (report 6)
# 25 times a second, as Unleash does for its custom effects (a 40 ms timer). Effect: default
# colors, at most that many colors, cycle in ms (None: it stands still unless given one).
ANIMATIONS = {"aurora": (["00ff90", "00a0ff", "6020ff"], 8, 10000),
              "fire": (["ff0000", "ff6000", "ffc000"], 8, 800),
              "rain": (["00ff40", "c0ffc0"], 2, 1500),
              "ripple": (["00c0ff", "ff00c0", "ffc000"], 8, 2500),
              "scanner": (["ff0000"], 1, 2000),
              "gradient": (["ff0080", "8000ff", "0080ff"], 8, None)}
FRAME_S = 0.04
ANIMATION_STATE = os.path.join(STATE, "animation.json")  # what runs now, and its process
ANIMATION_CONFIG = os.path.expanduser("~/.config/z20/animation.ini")  # --save: run by the service
ANIMATION_LIVE = os.path.join(os.environ.get("XDG_RUNTIME_DIR") or STATE, "z20-animation.ini")  # --live
ANIMATION_SERVICE = "z20-animate.service"


def led_layout(iso=True):
    """{LED position: (x, y)}: where each LED sits, in key widths from the top left (key
    centers), on a full-size keyboard (ISO or ANSI) with the macro keys E1-E5 to the left of
    the main block and the light bars at the sides. The scroll wheel has no LEDs here; where the logo
    LEDs sit isn't known, so they are put above the middle."""
    by_name = {name: pos for pos, name in LED_NAMES.items()}
    out = {}

    def keys(y, x, *names):  # left to right from x; "Tab:1.5" is 1.5 keys wide
        for key in names:
            name, _, width = key.partition(":")
            width = float(width or 1)
            out[by_name[name]] = (x + width / 2, y)
            x += width

    m = 1.25  # where the main block starts
    keys(0.5, 0, "Game")
    keys(0.5, m, "Esc")
    keys(0.5, m + 2, "F1", "F2", "F3", "F4")
    keys(0.5, m + 6.5, "F5", "F6", "F7", "F8")
    keys(0.5, m + 11, "F9", "F10", "F11", "F12")
    keys(0.5, m + 15.25, "PrintScreen", "ScrollLock", "Pause")
    keys(0.5, m + 18.5, "PrevTrack", "PlayPause", "NextTrack", "Mute")
    for y, name in zip((2, 3, 4, 5, 6), E_KEYS):
        keys(y, 0, name)
    keys(2, m, "`", *"1234567890", "-", "=", "Backspace:2")
    keys(2, m + 15.25, "Insert", "Home", "PageUp")
    keys(2, m + 18.5, "NumLock", "KP/", "KP*", "KP-")
    if iso:
        keys(3, m, "Tab:1.5", *"QWERTYUIOP", "[", "]")
        keys(3.5, m + 13.75, "Enter:1.25")
        keys(4, m, "CapsLock:1.75", *"ASDFGHJKL", ";", "'", "#")
        keys(5, m, "LShift:1.25", "ISO\\", *"ZXCVBNM", "Comma", ".", "/", "RShift:2.75")
    else:
        keys(3, m, "Tab:1.5", *"QWERTYUIOP", "[", "]", "\\:1.5")
        keys(4, m, "CapsLock:1.75", *"ASDFGHJKL", ";", "'", "Enter:2.25")
        keys(5, m, "LShift:2.25", *"ZXCVBNM", "Comma", ".", "/", "RShift:2.75")
    keys(3, m + 15.25, "Delete", "End", "PageDown")
    keys(3, m + 18.5, "KP7", "KP8", "KP9")
    keys(3.5, m + 21.5, "KPPlus")
    keys(4, m + 18.5, "KP4", "KP5", "KP6")
    keys(5, m + 16.25, "Up")
    keys(5, m + 18.5, "KP1", "KP2", "KP3")
    keys(5.5, m + 21.5, "KPEnter")
    keys(6, m, "LCtrl:1.25", "LGUI:1.25", "LAlt:1.25", "Space:6.25", "RAlt:1.25", "Fn:1.25", "Menu:1.25",
         "RCtrl:1.25")
    keys(6, m + 15.25, "Left", "Down", "Right")
    keys(6, m + 18.5, "KP0:2", "KP.")
    for i in range(9):  # top to bottom, as Unleash's wave runs them
        out[160 + i] = (-0.75, 0.25 + i * 0.75)
        out[176 + i] = (m + 23.25, 0.25 + i * 0.75)
    for i in range(4):
        out[192 + i] = (m + 9.75 + i * 0.5, -0.5)
    return out


def blend(colors, t, cyclic=False):
    """The color at t (0-1) along colors ((r, g, b) 0-255), mixed between the two nearest;
    cyclic: the last blends back into the first, and t wraps around."""
    n = len(colors)
    if n == 1:
        return tuple(colors[0])
    if cyclic:
        f = t % 1 * n
        i, j = int(f) % n, (int(f) + 1) % n
    else:
        f = min(max(t, 0.0), 1.0) * (n - 1)
        i = min(int(f), n - 2)
        j = i + 1
    k = f - int(f) if cyclic else f - i
    return tuple(a + (b - a) * k for a, b in zip(colors[i], colors[j]))


def scaled(color, k):
    return tuple(c * k for c in color)


def animation(effect, colors, cycle_ms, layout, rng=random):
    """The effect as a function of the time (s since it began) that gives every LED in the
    layout its color ((r, g, b) 0-255). Some effects keep state (flames, drops, ripples), so
    the times have to come in order."""
    xs, ys = [x for x, _ in layout.values()], [y for _, y in layout.values()]
    x0, x1, y0, y1 = min(xs), max(xs), min(ys), max(ys)
    cycle = cycle_ms / 1000 if cycle_ms else None
    if effect == "gradient":  # the colors from left to right; drifting with a cycle
        return lambda t: {p: blend(colors, (x - x0) / (x1 - x0) + (t / cycle if cycle else 0), cyclic=bool(cycle))
                          for p, (x, y) in layout.items()}
    if effect == "aurora":  # soft color fields, flowing through all the colors
        def aurora(t):
            s = 2 * math.pi * t / cycle
            cx = (x0 + x1) / 2 + (x1 - x0) / 3 * math.sin(s)
            cy = (y0 + y1) / 2 + (y1 - y0) / 2 * math.cos(2 * s)
            out = {}
            for p, (x, y) in layout.items():
                a = (math.sin(x * 0.3 + s) + math.sin(y * 0.8 - 2 * s) + math.sin((x + y) * 0.2 + 3 * s)
                     + math.sin(math.hypot(x - cx, y - cy) * 0.5 - 2 * s))
                out[p] = blend(colors, a / 5 + t / cycle, cyclic=True)
            return out
        return aurora
    if effect == "scanner":  # a light running from side to side and back
        def scanner(t):
            at = x0 + (x1 - x0) * (1 - math.cos(2 * math.pi * t / cycle)) / 2
            return {p: scaled(colors[0], math.exp(-((x - at) / 1.5) ** 2)) for p, (x, y) in layout.items()}
        return scanner
    if effect == "fire":  # flames rising from the bottom row, the colors from embers to tips
        cols, rows = int(x1 - x0) + 3, int(y1 - y0) + 3  # a cell per key; the bottom row feeds the flames
        heat = [[0.0] * cols for _ in range(rows)]
        before = [row[:] for row in heat]
        step = cycle / rows  # the flames rise a row in this time
        palette = [(0, 0, 0), *colors]
        last = [0.0]

        def fire(t):
            if t - last[0] > 1:
                last[0] = t - step
            while last[0] + step <= t:
                last[0] += step
                before[:] = [row[:] for row in heat]
                heat[-1] = [rng.random() ** 0.4 for _ in range(cols)]  # mostly hot, now and then a gap
                for r in range(rows - 1):
                    for c in range(cols):
                        below = heat[r + 1][min(max(c + rng.randint(-1, 1), 0), cols - 1)]
                        heat[r][c] = max(0.0, below - rng.random() * 3.2 / rows)
            k = (t - last[0]) / step  # between the last two steps
            out = {}
            for p, (x, y) in layout.items():
                r, c = round((y - y0) / (y1 - y0) * (rows - 2)), round(x - x0) + 1
                out[p] = blend(palette, (before[r][c] + (heat[r][c] - before[r][c]) * k) ** 1.3)  # darker tips
            return out
        return fire
    if effect == "rain":  # drops falling down each column with a fading trail
        cols, trail = int(x1 - x0) + 2, 2.5
        speed = (y1 - y0 + trail) / cycle
        drops = [y0 - rng.random() * 2 * (y1 - y0 + trail) for _ in range(cols)]
        speeds = [speed * (0.7 + 0.6 * rng.random()) for _ in range(cols)]
        head = colors[1] if len(colors) > 1 else colors[0]
        last = [None]

        def rain(t):
            dt = 0.0 if last[0] is None else min(t - last[0], 1.0)
            last[0] = t
            for c in range(cols):
                drops[c] += speeds[c] * dt
                if drops[c] - trail > y1 + 0.5:  # gone: the next one after a pause
                    drops[c] = y0 - 0.5 - rng.random() * (y1 - y0) / 2
                    speeds[c] = speed * (0.7 + 0.6 * rng.random())
            out = {}
            for p, (x, y) in layout.items():
                d = drops[round(x - x0)] - y  # how far the drop is below this LED
                if -0.5 <= d < 0.5:
                    out[p] = head
                elif 0.5 <= d < trail:
                    out[p] = scaled(colors[0], 1 - (d - 0.5) / (trail - 0.5))
                else:
                    out[p] = (0, 0, 0)
            return out
        return rain
    if effect == "ripple":  # rings spreading from random keys, one color after another
        spots = [layout[p] for p in KEY_POSITIONS if p in layout]
        ripples = []  # x, y, start, color
        due, count = [0.0], [0]

        def ripple(t):
            if due[0] < t - cycle:
                due[0] = t
            while due[0] <= t:
                x, y = rng.choice(spots)
                ripples.append((x, y, due[0], colors[count[0] % len(colors)]))
                count[0] += 1
                due[0] += cycle / 4 * (0.5 + rng.random())
            ripples[:] = [r for r in ripples if t - r[2] < cycle]
            out = {}
            for p, (x, y) in layout.items():
                mix = [0.0, 0.0, 0.0]
                for rx, ry, start, color in ripples:
                    age = (t - start) / cycle
                    k = math.exp(-((math.hypot(x - rx, y - ry) - age * 10) / 1.5) ** 2) * (1 - age)
                    mix = [m + c * k for m, c in zip(mix, color)]
                out[p] = tuple(min(m, 255.0) for m in mix)
            return out
        return ripple
    raise Z20Error(f"no effect {effect}")


def animation_frame(colors, level):
    """An LED frame from {position: (r, g, b)}, every LED at the given brightness (0-255)."""
    frame = bytearray(LED_COUNT * 4)
    for pos, color in colors.items():
        frame[pos * 4:pos * 4 + 4] = bytes([level, *(min(max(round(c), 0), 255) for c in color)])
    return frame


def screen_locked(desktop):
    answer = desktop.query("call", "org.freedesktop.ScreenSaver", "/ScreenSaver", "org.freedesktop.ScreenSaver",
                           "GetActive")
    return answer.split() == ["b", "true"]


def process_state(path, command):
    """The JSON state a running z20 command (animate, backlight) keeps in path, or None once its
    process has ended."""
    try:
        with open(path) as f:
            state = json.load(f)
        with open(f"/proc/{int(state['pid'])}/cmdline", "rb") as f:
            argv = f.read().split(b"\0")
        if command.encode() not in argv or not any(a.endswith(b"z20") for a in argv):
            return None  # that process ended, and the number went to another
    except (OSError, ValueError, KeyError, TypeError):
        return None
    return state


def animation_state():
    """What z20 animate runs now ({pid, effect, colors, cycle_ms, brightness, how}), or None."""
    return process_state(ANIMATION_STATE, "animate")


def end_process(read_state):
    """Stop the z20 run that read_state() names, and wait (up to 3 s) until it has ended."""
    state = read_state()
    if not state or state["pid"] == os.getpid():
        return
    os.kill(state["pid"], signal.SIGTERM)
    for _ in range(30):
        time.sleep(0.1)
        if not read_state():
            return


def end_animation():
    """Stop the z20 animate that runs (it shows the profile's lighting again when it ends)."""
    end_process(animation_state)


def run_animation(effect, colors, cycle, brightness, how):
    """Send the effect's frames until stopped (Ctrl+C, SIGTERM, a new z20 animate). It holds
    the keyboard only while sending a frame, so other z20 runs go on in between; it pauses
    while the screen is locked, while the keyboard is unplugged and while z20 backlight has the
    lighting off, and is as much dimmer as z20 backlight dims."""
    end_animation()

    def stop(_signum, _frame):
        raise KeyboardInterrupt
    signal.signal(signal.SIGTERM, stop)
    save_json(ANIMATION_STATE, {"pid": os.getpid(), "effect": effect, "colors": colors, "cycle_ms": cycle,
                                "brightness": brightness, "how": how})
    colors_at = None  # once the keyboard is there: its layout (ISO or ANSI)
    level = 0xFF if brightness is None else round(brightness * 255 / 100)
    desktop, kb, shown, sent, locked, looked, trouble = Desktop(), None, None, 0.0, False, -10.0, None
    dark = False  # z20 backlight has the lighting off
    say = lambda text: print(f"{time.strftime('%H:%M:%S')}  {text}", flush=True)
    say(f"z20 animate {effect}: running")
    start = time.monotonic()
    try:
        while True:
            now = time.monotonic()
            checked = waited = 0.0
            if now - looked >= 2:
                was = locked
                locked, looked = screen_locked(desktop), now
                checked = time.monotonic() - now
                if locked != was:
                    say("screen locked: paused, the profile's lighting shows" if locked else "screen unlocked: on again")
            percent = backlight_percent()
            if (percent == 0) != dark:
                dark = not dark
                say("keyboard light off: paused" if dark else "keyboard light on: on again")
            try:
                if kb is None:
                    kb = Keyboard(lock=False)
                    if trouble:
                        say("keyboard back: on again")
                        trouble = None
                if colors_at is None:
                    layout = led_layout(iso=kb.model.endswith("ISO"))
                    colors_at = animation(effect, [tuple(parse_color(c)) for c in colors], cycle, layout)
                if locked or dark:
                    if shown is not None:
                        kb.send_locked(bytes([6, *HEADER, 0]))  # the profile's lighting (dark: dimmed to 0)
                        shown = None
                    time.sleep(0.5)
                    continue
                frame = animation_frame(colors_at(now - start), round(level * percent / 100))
                if frame != shown or now - sent >= 1:  # still effects: once a second
                    waited = kb.send_locked(color_report(frame))
                    shown, sent = frame, now
            except Z20Error as e:  # unplugged: wait for it
                if str(e) != trouble:
                    say(f"{e}: waiting for the keyboard")
                    trouble = str(e)
                if kb:
                    kb.close()
                kb, shown = None, None
                time.sleep(2)
                continue
            took = time.monotonic() - now
            if took > 2 * FRAME_S:  # a frame that came late: why
                say(f"a frame took {took * 1000:.0f} ms: {waited * 1000:.0f} ms waiting while another z20 run "
                    f"had the keyboard, {checked * 1000:.0f} ms asking whether the screen is locked")
            time.sleep(max(0.0, FRAME_S - took))
    except KeyboardInterrupt:
        pass
    finally:
        signal.signal(signal.SIGTERM, signal.SIG_DFL)
        try:
            kb = kb or Keyboard(lock=False)
            kb.send_locked(bytes([6, *HEADER, 0]))
        except Z20Error:
            pass
        if kb:
            kb.close()
        if (animation_state() or {}).get("pid") == os.getpid():
            os.remove(ANIMATION_STATE)


def save_json(path, data):
    os.makedirs(os.path.dirname(path), mode=0o700, exist_ok=True)
    with open(os.open(path + ".new", os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600), "w") as f:
        json.dump(data, f)
    os.replace(path + ".new", path)  # z20 animate reads the backlight's every frame: never half of it


def write_animation(path, effect, colors, cycle, brightness):
    os.makedirs(os.path.dirname(path), exist_ok=True)
    with open(path, "w") as f:
        f.write(f"# z20 animate {effect} ... --save writes this; the z20-animate service runs it.\n"
                f"[animation]\neffect = {effect}\ncolors = {', '.join(colors)}\n"
                + (f"cycle = {cycle}\n" if cycle else "") + (f"brightness = {brightness}\n" if brightness is not None else ""))


def saved_animation():
    """(effect, colors, cycle, brightness, how) from the --live file, else the --save one; or None."""
    for path, how in ((ANIMATION_LIVE, "live"), (ANIMATION_CONFIG, "saved")):
        if not os.path.exists(path):
            continue
        parser = configparser.ConfigParser(interpolation=None)
        try:
            parser.read(path)
            section = parser["animation"]
            effect = section["effect"]
            colors = [c.strip().lstrip("#") for c in section.get("colors", "").split(",") if c.strip()]
            cycle = int(section["cycle"]) if section.get("cycle") else None
            brightness = int(section["brightness"]) if section.get("brightness") else None
        except (configparser.Error, KeyError, ValueError) as e:
            raise Z20Error(f"{path}: {e}") from None
        check_animation(effect, colors, cycle, brightness, path)
        return effect, colors or ANIMATIONS[effect][0], cycle or ANIMATIONS[effect][2], brightness, how
    return None


def check_animation(effect, colors, cycle, brightness, where="animate"):
    if effect not in ANIMATIONS:
        raise Z20Error(f"{where}: no effect {effect} ({', '.join(ANIMATIONS)})")
    most = ANIMATIONS[effect][1]
    if len(colors) > most:
        raise Z20Error(f"{where}: {effect} takes at most {most} color{'s' if most > 1 else ''}")
    for c in colors:
        parse_color(c)
    if cycle is not None and not 100 <= cycle <= 600000:
        raise Z20Error(f"{where}: cycle 100-600000 ms")
    if brightness is not None and not 0 <= brightness <= 100:
        raise Z20Error(f"{where}: brightness 0-100")


def systemctl(*args, check=False):
    try:
        done = subprocess.run(["systemctl", "--user", *args], capture_output=True, text=True, timeout=30)
    except (OSError, subprocess.TimeoutExpired) as e:
        if check:
            raise Z20Error(f"systemctl: {e}") from None
        return ""
    if check and done.returncode:
        raise Z20Error(f"systemctl --user {' '.join(args)}: {done.stderr.strip() or done.returncode}"
                       + (" (install.sh installs the z20 services)" if "not found" in done.stderr else ""))
    return done.stdout.strip()


def started(effect):
    """The state once the service runs the effect (it takes a moment to start)."""
    for _ in range(30):
        state = animation_state()
        if state and state["effect"] == effect or effect is None:
            return state
        time.sleep(0.1)
    return animation_state()


def animate_command(v, args):
    """z20 animate [EFFECT ... | off | reload | saved]; returns what to print."""
    if not v:
        return animation_state()
    if v[0] == "saved":  # what the service runs
        saved = saved_animation()
        if saved:
            run_animation(*saved)
        return None
    if v[0] in ("off", "reload"):
        if os.path.exists(ANIMATION_LIVE):
            os.remove(ANIMATION_LIVE)
        if v[0] == "reload" and systemctl("is-enabled", ANIMATION_SERVICE) == "enabled":
            systemctl("restart", ANIMATION_SERVICE, check=True)  # back to the saved effect
            return started(saved_animation()[0] if saved_animation() else None)
        else:
            if v[0] == "off" and not args.live:
                systemctl("disable", "--now", ANIMATION_SERVICE)  # also not after the next login
            else:
                systemctl("stop", ANIMATION_SERVICE)
            end_animation()  # one running in a terminal, too
        return animation_state()
    effect, colors = v[0], [c.lstrip("#") for c in v[1:]] or ANIMATIONS[v[0]][0]
    cycle = args.cycle or ANIMATIONS[effect][2]
    check_animation(effect, colors, cycle, args.brightness)
    if args.save or args.live:
        write_animation(ANIMATION_LIVE if args.live else ANIMATION_CONFIG, effect, colors, cycle, args.brightness)
        if args.save:
            if os.path.exists(ANIMATION_LIVE):
                os.remove(ANIMATION_LIVE)
            systemctl("enable", ANIMATION_SERVICE, check=True)
        systemctl("restart", ANIMATION_SERVICE, check=True)
        return started(effect)
    run_animation(effect, colors, cycle, args.brightness, "here")
    return None


# z20 backlight: the Z20's own keyboard light, a level (percent of how the lighting is set) that
# the z20-backlight service keeps, and off while the desktop has its keyboard light off. The desktop's
# is UPower's keyboard backlight, which KDE Plasma (PowerDevil) and GNOME set: their slider, the
# brightness keys, off when the screen dims or goes off while idle. PowerDevil knows one keyboard
# light, UPower's first (a laptop's own; from UPower 1.91.4 on all of them at once). From it z20
# takes a new level (Plasma's slider at low: 50 % on a ThinkPad's 3 steps), off and on again, as the
# desktop sets it (UPower: 'external'), not what the laptop does itself ('internal': its own Fn key;
# a ThinkPad with the lid closed puts its last level back when set to 0). Nor the off that comes
# with closing the lid: PowerDevil turns the laptop's keys dark then, even with screens attached,
# and again on each power profile load while the lid is closed (settings saved, AC plugged in or
# out); its lidClosedChanged on the session bus says so each time, UPower's lid only the first.
# The same off comes when PowerDevil dims the screens while idle: z20 then asks kscreen-doctor (KDE)
# and dims the Z20 as much as the screens are (30 %), and turns it off with the screens. Where the
# kernel's uleds may be used, the level is also an LED of its own, which UPower offers as a keyboard
# light (and systemd-backlight may keep).
LID_OFF_S = 3  # an off this soon after the lid closed is the lid's
# After the desktop's off, look at the screens then (KWin has dimmed them within about half a
# second), again, and so on while they are dimmed.
SCREENS_S = (0.5, 2, 20)
UPOWER_KBD = ("org.freedesktop.UPower", "/org/freedesktop/UPower/KbdBacklight", "org.freedesktop.UPower.KbdBacklight")
BACKLIGHT_STATE = os.path.join(os.environ.get("XDG_RUNTIME_DIR") or STATE, "z20-backlight.json")
BACKLIGHT_LEVEL = os.path.join(STATE, "backlight.json")  # z20 backlight P: the level, kept over logins
BACKLIGHT_SERVICE = "z20-backlight.service"
ULEDS = "/dev/uleds"
LED_NAME = "evga_z20::kbd_backlight"  # max 100: the level
UPOWER_LED = UPOWER_KBD[1] + "/" + LED_NAME.replace(":", "o")  # as UPower names its object
COLORS = os.path.join(STATE, "colors.bin")  # z20 color: the colors per LED, as set


def backlight_state():
    """What z20 backlight does now: {pid, percent (how bright it has the lighting), level, off (the
    desktop's keyboard light), led (it has its LED), and the effect it dims in RAM with that block
    as set and as shown (hex)}, or None if it doesn't run."""
    return process_state(BACKLIGHT_STATE, "backlight")


def backlight_percent():
    """How bright z20 backlight has the lighting, in percent of how it is set: 100 without it."""
    state = backlight_state()
    return state["percent"] if state else 100


def backlight_level():
    """The Z20's keyboard light as set with z20 backlight P: 100 until then."""
    try:
        with open(BACKLIGHT_LEVEL) as f:
            return min(max(int(json.load(f)["percent"]), 0), 100)
    except (OSError, ValueError, KeyError, TypeError):
        return 100


def backlight_info():
    """{percent: the level, shown: how bright the lighting is, off: the desktop's keyboard light is
    off, dimmed: with the screens, service: z20-backlight runs, led: it has its LED}."""
    state = backlight_state() or {}
    return {"percent": backlight_level(), "shown": state.get("percent", 100), "off": state.get("off", False),
            "dimmed": 0 < state.get("dim", 1) < 1, "service": bool(state), "led": state.get("led", False)}


def backlight_text(info):
    if not info["service"]:
        return f"keyboard light {info['percent']} %, but z20-backlight doesn't run: the lighting shows as set"
    return f"keyboard light {info['percent']} %" + ("; dark while the desktop has its keyboard light off"
                                                    if info["off"] else f"; {info['shown']} % while the desktop "
                                                    "dims its screens" if info["dimmed"] else "")


def upower_get(path, method):
    """GetBrightness or GetMaxBrightness of one of UPower's keyboard lights; None if it has none there."""
    try:
        out = subprocess.run(["busctl", "--system", "call", UPOWER_KBD[0], path, UPOWER_KBD[2], method],
                             capture_output=True, text=True, timeout=5).stdout.split()
    except (OSError, subprocess.TimeoutExpired):
        return None
    return int(out[1]) if len(out) == 2 and out[0] == "i" else None


def desktop_level(value, most, last):
    """The Z20's level from the keyboard light the desktop set (value of most), or None for keeping its
    own: at 0 (off, dimming), at the value it set last (brought back after dimming, the lid, a
    suspend), without a maximum."""
    if not value or value == last or not most:
        return None
    return round(min(value, most) * 100 / most)


def upower_set(path, value):
    """Set one of UPower's keyboard lights (UPower writes it, as root); False if it has none there."""
    try:
        return subprocess.run(["busctl", "--system", "call", UPOWER_KBD[0], path, UPOWER_KBD[2], "SetBrightness",
                               "i", str(value)], capture_output=True, timeout=5).returncode == 0
    except (OSError, subprocess.TimeoutExpired):
        return False


def set_backlight(word):
    """z20 backlight P | up | down: the level saved, on its LED, and z20-backlight told (or enabled,
    as it keeps the level). Returns the level."""
    level = backlight_level()
    level = min(100, level + 10) if word == "up" else max(0, level - 10) if word == "down" else int(word)
    save_json(BACKLIGHT_LEVEL, {"percent": level})
    state = backlight_state()
    if state:
        try:
            os.kill(state["pid"], signal.SIGUSR2)
        except OSError:
            pass
        upower_set(UPOWER_LED, level)  # its LED in step, through UPower (it writes the LED as root)
        return level
    systemctl("enable", "--now", BACKLIGHT_SERVICE, check=True)  # it gives its LED the level itself
    for _ in range(30):  # it takes a moment to start
        if backlight_state():
            break
        time.sleep(0.1)
    return level


def nudge_backlight():
    """The lighting in RAM changed: z20 backlight, while it dims, dims the new one at once."""
    state = backlight_state()
    if state and state["pid"] != os.getpid() and state["percent"] < 100:
        try:
            os.kill(state["pid"], signal.SIGUSR1)
        except OSError:
            pass


def dimmed(block, effect, percent):
    """A RAM lighting block of `effect` as set (from the effect's start in the profile) with its
    brightness bytes at percent."""
    block = bytearray(block)
    at = RAM_BLOCKS[effect][1]
    for i in BRIGHTNESS_AT.get(effect, ()):
        block[i - at] = round(block[i - at] * percent / 100)
    return bytes(block)


class Dimmer:
    """Dims the keyboard's own lighting in RAM: the running effect's brightness bytes, to a
    percent of how it is set. RAM no longer holding what it wrote means a new lighting (z20 light,
    a profile switch, the Fn keys, a reload), which it then takes as set; an effect left behind
    gets its block back as it was set."""

    def __init__(self):
        self.effect, self.base, self.shown = None, None, None  # the effect it dims, as set, as shown

    def apply(self, kb, percent):
        effect = kb.read_ram(RAM_EFFECT)[0]
        if self.effect is not None and self.effect != effect:
            block, _, size = RAM_BLOCKS[self.effect]
            ram = bytearray(kb.read_ram(block))
            if ram[:size] == self.shown != self.base:
                ram[:size] = self.base
                kb.write_ram(block, ram)
            self.effect = None
        if effect in RAM_BLOCKS:
            block, _, size = RAM_BLOCKS[effect]
            ram = bytearray(kb.read_ram(block))
            if effect != self.effect or ram[:size] != self.shown:
                self.base = bytes(ram[:size])
            self.effect, self.shown = effect, dimmed(self.base, effect, percent)
            if ram[:size] != self.shown:
                ram[:size] = self.shown
                kb.write_ram(block, ram)

    def state(self):
        if self.effect is None:
            return {"effect": None, "block": None, "shown": None}
        return {"effect": self.effect, "block": self.base.hex(), "shown": self.shown.hex()}

    def resume(self, state):
        """Go on from the state a z20 backlight that was killed left: RAM may still be dimmed."""
        if state.get("effect") in RAM_BLOCKS:
            self.effect, self.base, self.shown = state["effect"], bytes.fromhex(state["block"]), bytes.fromhex(state["shown"])


def show_colors(kb, percent):
    """The colors per LED of z20 color again, at percent, unless z20 animate covers them."""
    if os.path.exists(COLORS) and not animation_state():
        with open(COLORS, "rb") as f:
            kb.send(color_report(dimmed_frame(f.read(), percent)))


def desktop_set(line):
    """The keyboard light the desktop set, from a line of gdbus monitor on UPower: on its first
    keyboard light, the one PowerDevil knows. None for other lines: the laptop's own changes, the
    other keyboard lights (the Z20's LED among them)."""
    m = re.fullmatch(re.escape(UPOWER_KBD[1].encode()) + rb": org\.freedesktop\.UPower\.KbdBacklight\."
                     rb"BrightnessChangedWithSource \((\d+), '(\w+)'\)", line.rstrip())
    return int(m[1]) if m and m[2] == b"external" else None


def lid_closed(line):
    """True if a line of gdbus monitor on UPower or PowerDevil says the laptop's lid was closed (or,
    PowerDevil, that it acts again on the closed lid), False if opened, else None."""
    if line.startswith(b"/org/freedesktop/UPower: org.freedesktop.DBus.Properties.PropertiesChanged "):
        m = re.search(rb"'LidIsClosed': <(true|false)>", line)
    else:
        m = re.fullmatch(rb"/org/kde/Solid/PowerManagement: org\.kde\.Solid\.PowerManagement\.lidClosedChanged "
                         rb"\((true|false),\)", line.rstrip())
    return m[1] == b"true" if m else None


def screens():
    """How the desktop has its screens, from kscreen-doctor (KDE): (all of them off, how far it
    dims them: 0.3 for 30 %, 1 for not at all); (False, 1.0) where it can't tell."""
    def run(*args):
        try:
            return subprocess.run(["kscreen-doctor", *args], capture_output=True, text=True, timeout=5).stdout
        except (OSError, subprocess.TimeoutExpired):
            return ""
    ratios = []
    for output in re.split(r"(?m)^Output: ", re.sub(r"\x1b\[[0-9;]*m", "", run("-o")))[1:]:  # without its colors
        m = re.search(r"dimming to (\d+)%", output)
        if m and re.search(r"(?m)^\s*enabled\s*$", output):
            ratios.append(int(m[1]) / 100)
    modes = re.findall(r"dpms mode for screen \S+: (\w+)", run("--dpms", "show"))
    return bool(modes) and "on" not in modes, min(ratios, default=1.0)


def backlight():
    """Keep the lighting at the Z20's level until stopped, dimmed with the screens and dark while
    the desktop has its keyboard light off otherwise: the keyboard's own in RAM (never stored), z20
    animate's frames (they pause at 0) and z20 color's. Hears of the level through SIGUSR2 (z20
    backlight P) and its LED, of the desktop through gdbus monitor, of z20's own lighting changes
    through SIGUSR1 (nudge_backlight); while dimmed it looks every second whether the keyboard
    changed the lighting itself (Fn keys, unplugged). Stopped, it leaves the lighting as it is set."""
    say = lambda text: print(f"{time.strftime('%H:%M:%S')}  {text}", flush=True)
    end_process(backlight_state)  # one at a time: a second would take the first one's dimming as set
    dimmer, applied = Dimmer(), 100  # applied: the percent the keyboard has; it starts as set
    try:
        with open(BACKLIGHT_STATE) as f:  # left by one that was killed
            dimmer.resume(json.load(f))
        applied = None
    except (OSError, ValueError, KeyError, TypeError):
        pass
    level, led, synced = backlight_level(), None, None
    asked = upower_get(UPOWER_KBD[1], "GetBrightness") or None  # the desktop's keyboard light as set last
    # dark: the desktop has its keyboard light off; dim: how much of the level that leaves (1, 0.3 while
    # it dims the screens, 0); look: when to look at the screens next, looks: how often it did since
    dark, dim, look, looks = False, 1.0, None, 0
    try:
        led = os.open(ULEDS, os.O_RDWR)
        os.write(led, LED_NAME.encode().ljust(64, b"\0") + (100).to_bytes(4, sys.byteorder))
        # What it reads in the first moments is systemd-backlight bringing back the last login's
        # level; z20's own counts, and goes to the LED through UPower once it has the LED.
        synced = time.monotonic() + 2
    except OSError as e:
        if led is not None:
            os.close(led)
            led = None
        say(f"no keyboard light of its own ({ULEDS}: {e.strerror}; see the README)")
    try:  # UPower: the keyboard lights and the lid; PowerDevil: its lid handling
        monitors = [subprocess.Popen(["gdbus", "monitor", *args], stdout=subprocess.PIPE, stderr=subprocess.DEVNULL)
                    for args in (["--system", "--dest", UPOWER_KBD[0]],
                                 ["--session", "--dest", "org.kde.Solid.PowerManagement",
                                  "--object-path", "/org/kde/Solid/PowerManagement"])]
    except OSError as e:
        raise Z20Error(f"gdbus: {e.strerror} (it comes with GLib: libglib2.0-bin, glib2)") from None
    pending = {m.stdout.fileno(): b"" for m in monitors}  # what came of a line so far
    wake_r, wake_w = os.pipe()  # signals wake the select below
    os.set_blocking(wake_w, False)

    def stop(_signum, _frame):
        raise KeyboardInterrupt
    signal.signal(signal.SIGTERM, stop)
    signal.signal(signal.SIGUSR1, lambda _signum, _frame: None)
    signal.signal(signal.SIGUSR2, lambda _signum, _frame: None)
    signal.set_wakeup_fd(wake_w)
    stops = {signal.SIGTERM, signal.SIGINT}  # held back while it changes the lighting: never half done

    def light(percent):
        nonlocal applied
        signal.pthread_sigmask(signal.SIG_BLOCK, stops)
        try:
            kb = Keyboard()
            try:
                dimmer.apply(kb, percent)
                if applied != percent:
                    show_colors(kb, percent)
                applied = percent
            finally:
                kb.close()
        finally:
            signal.pthread_sigmask(signal.SIG_UNBLOCK, stops)

    said, saved, trouble = None, None, None
    lid = dark_at = float("-inf")  # when the lid closed (or PowerDevil acted on it again), the desktop's off
    try:
        while True:
            now = time.monotonic()
            if synced is not None and now >= synced:
                synced = None if upower_set(UPOWER_LED, level) else now + 5  # UPower may not have it yet
            if dark and look is not None and now >= look:
                screens_off, ratio = screens()
                dim = ratio if 0 < ratio < 1 and not screens_off else 0.0
                looks += 1
                look = now + SCREENS_S[min(looks, 2)] if looks == 1 or 0 < dim < 1 else None
            if (level, dim) != said:
                say(f"keyboard light {level} %" + ("" if dim == 1 else ": dark, the desktop has its keyboard light off"
                                                    if dim == 0 else f": {dim:.0%} of it, the desktop dims its screens"))
                said = (level, dim)
            percent = round(level * dim)
            if percent < 100 or applied != percent:
                try:
                    light(percent)
                    if trouble:
                        say("keyboard back")
                        trouble = None
                except Z20Error as e:
                    if str(e) != trouble:
                        say(f"waiting for the keyboard: {e}")
                        trouble = str(e)
                    applied = None if percent < 100 else percent  # plugged in again, it starts as set
            state = {"pid": os.getpid(), "percent": percent, "level": level, "off": dim == 0, "dim": dim,
                     "led": led is not None, **dimmer.state()}
            if state != saved:
                save_json(BACKLIGHT_STATE, state)
                saved = state
            timeout = None if applied == percent == 100 else 2 if trouble else 1
            for at in (synced, look):
                if at is not None:
                    timeout = max(0.0, at - now if timeout is None else min(timeout, at - now))
            ready = select.select([*pending, wake_r, *([led] if led is not None else [])], [], [], timeout)[0]
            if wake_r in ready and signal.SIGUSR2 in os.read(wake_r, 64):  # z20 backlight P: light it
                level, dark, dim, look = backlight_level(), False, 1.0, None
            if led is not None and led in ready:
                value = int.from_bytes(os.read(led, 4), sys.byteorder, signed=True)
                if synced is None and 0 <= value <= 100 and value != level:  # set through UPower
                    level = value
                    save_json(BACKLIGHT_LEVEL, {"percent": level})
            for fd in (fd for fd in ready if fd in pending):
                data = os.read(fd, 4096)
                if not data:
                    raise Z20Error("gdbus monitor ended")
                *lines, pending[fd] = (pending[fd] + data).split(b"\n")
                for line in lines:
                    now = time.monotonic()
                    if lid_closed(line):
                        lid = now
                        if dark and now - dark_at < LID_OFF_S:  # its off came first (the buses don't wait)
                            dark, dim, look = False, 1.0, None
                            say("the lid is closed: the desktop has its keyboard light off for the laptop's keys, "
                                "the Z20 stays lit")
                    elif desktop_set(line) == 0 and now - lid < LID_OFF_S:
                        say("the lid is closed: the desktop has its keyboard light off for the laptop's keys, "
                            "the Z20 stays lit")
                    elif desktop_set(line) == 0:  # off, or the screens dim or go off: look at them
                        dark, dark_at, look, looks = True, now, now + SCREENS_S[0], 0
                    elif desktop_set(line) is not None:  # on; its slider or keys: a new level
                        new = desktop_level(desktop_set(line), upower_get(UPOWER_KBD[1], "GetMaxBrightness"), asked)
                        if new is not None and new != level:
                            level = new
                            save_json(BACKLIGHT_LEVEL, {"percent": level})
                            if led is not None and synced is None:
                                upower_set(UPOWER_LED, level)  # its LED in step
                        dark, dim, look, asked = False, 1.0, None, desktop_set(line)
    except KeyboardInterrupt:
        pass
    finally:
        signal.signal(signal.SIGUSR1, signal.SIG_IGN)
        signal.signal(signal.SIGUSR2, signal.SIG_IGN)
        signal.signal(signal.SIGTERM, signal.SIG_IGN)  # a second one doesn't cut this short
        signal.set_wakeup_fd(-1)
        for m in monitors:
            m.terminate()
        if led is not None:
            os.close(led)  # the LED goes; systemd-backlight keeps its level for the next login
        if applied is not None and applied < 100:  # the lighting as it is set again
            try:
                light(100)
            except Z20Error:
                pass
        if os.path.exists(BACKLIGHT_STATE):  # only now: a z20 backlight that waits for this one goes on
            os.remove(BACKLIGHT_STATE)
        signal.signal(signal.SIGTERM, signal.SIG_DFL)


# Parts of a profile that "default" takes from the factory profile (offset, size): the effect
# and the effects Unleash's own lighting reset copies (static to stars), and the sensor.
FACTORY_LIGHTING = [(P_EFFECT, 2), (P_STATIC, P_FADE - P_STATIC)]
FACTORY_SENSOR = [(P_SENSOR, 31)]


def from_factory(p, factory, parts):
    p = bytearray(p)
    for at, size in parts:
        p[at:at + size] = factory[at:at + size]
    return p


def rate_hz(p):
    return {v: k for k, v in RATES.items()}.get(p[P_RATE], 8000 if p[P_RATE] == 3 else None)


def game_keys(p):
    """The keys Game Mode blocks; the profile keeps their bits inverted, as Unleash writes them."""
    return [name for name, bit in GAME_KEYS.items() if ~p[P_GAME_KEYS] & bit]


def set_game_keys(p, names):
    p = bytearray(p)
    p[P_GAME_KEYS] = ~sum(GAME_KEYS[n] for n in set(names)) & 0xFF
    return p


def set_profile_name(p, name):
    raw = name.encode("utf-16-le")
    if not name or len(raw) > 126:
        raise Z20Error("profile name: 1 to 63 characters")
    p = bytearray(p)
    p[P_NAME_LEN:P_NAME_LEN + 2] = (len(raw) // 2).to_bytes(2, "little")
    p[P_NAME:P_NAME + 126] = raw + b"\xff" * (126 - len(raw))  # padded as the profiles have it
    return p


def keyboard_event(data):
    """An input report from interface 1 as a dict; None for the mouse reports macros send."""
    if data[:1] == b"\x01":
        return None
    if data[:1] == b"\x03" and len(data) > 2:
        return {"event": STATUS_EVENTS.get(data[1], f"status 0x{data[1]:02x}"), "value": data[2]}
    if data[:1] == b"\x02" and len(data) > 2:
        usage = data[1] | data[2] << 8
        return {"event": "media key", "key": CONSUMER.get(usage, f"0x{usage:03x}") if usage else "up"}
    return {"event": "report", "data": data.hex(" ")}


def watch_events(as_json, wait=None):
    """Print what the keyboard reports on interface 1 until Ctrl+C; waits while it is unplugged.
    With wait, only the first event within that many seconds, then it ends (a widget runs it
    again and again); media keys don't count there, since every volume step sends some and they
    change nothing on the keyboard. Only reads input reports, so it needs no lock and sends nothing."""
    deadline = None if wait is None else time.monotonic() + wait
    left = lambda: None if deadline is None else deadline - time.monotonic()
    trouble = None
    while deadline is None or left() > 0:
        try:
            fd = os.open(find_keyboard()[0], os.O_RDONLY)
        except (Z20Error, OSError) as e:
            if str(e) != trouble and deadline is None:
                print(f"waiting for the keyboard: {e}", file=sys.stderr, flush=True)
            trouble = str(e)
            time.sleep(2 if deadline is None else max(0, min(2, left())))
            continue
        trouble = None
        try:
            while True:
                if deadline is not None and (left() <= 0 or not select.select([fd], [], [], left())[0]):
                    return
                data = os.read(fd, 64)
                event = keyboard_event(data)
                if event and not (deadline is not None and event["event"] == "media key"):
                    print(json.dumps(event) if as_json else f"{time.strftime('%H:%M:%S')}  {interface_event(data)}",
                          flush=True)
                    if deadline is not None:
                        return
        except OSError:
            pass  # unplugged: wait for it again
        finally:
            os.close(fd)


def profile_name(p):
    length = p[P_NAME_LEN] | p[P_NAME_LEN + 1] << 8
    return p[P_NAME:P_NAME + min(2 * length, 126)].decode("utf-16-le", "replace")


def status(kb):
    n = kb.profile_number()
    p = kb.read_profile(n)
    names = {m: kb.macro_name(m) for m in kb.macro_slots()}
    keys = {}
    for label, pos in E_KEYS.items():
        for layer, base in ((label, P_KEYS), (f"Fn+{label}", P_FN_KEYS)):
            b = p[base + pos * 4:base + pos * 4 + 4]
            if layer == label or b[0] != 0xFF:  # the Fn layer only where it does something
                text, info = key_function(b, names)
                keys[layer] = {"text": text, **info}
    changed = {}
    for label, b in changed_keys(p, kb.read_profile(DEFAULT_PROFILE), skip=E_KEYS.values()):
        text, info = key_function(b, names)
        changed[label] = {"text": text, **info}
    return {"model": kb.model, "firmware": kb.firmware(), "profile": n, "profile_name": profile_name(p),
            "game_mode": kb.game_mode(), "game_mode_blocks": game_keys(p), "nkro": kb.nkro(),
            "report_rate": rate_hz(p), "lighting": lighting(p), "animation": animation_info(),
            "backlight": backlight_info(),
            "keys": keys, "changed_keys": changed, "macros": {str(m): name for m, name in names.items()}}


def animation_info():
    state = animation_state()
    return {k: state[k] for k in ("effect", "colors", "cycle_ms", "brightness", "how")} if state else None


def animation_text(state):
    if not state:
        return "no software effect runs (z20 animate)"
    where = {"here": "in a terminal", "saved": "saved, the z20-animate service",
             "live": "for now, the z20-animate service"}.get(state["how"], state["how"])
    return " ".join([f"z20 animate {state['effect']}", *("#" + c for c in state["colors"]),
                     *([f"{state['cycle_ms']} ms"] if state["cycle_ms"] else []),
                     *([f"{state['brightness']} %"] if state["brightness"] is not None else [])]) + f" ({where})"


def presence_settings():
    cfg = presence_config()
    steps = lambda event: [{"action": a, "after_s": d} for a, d in cfg[event]]
    return {"config": PRESENCE_CONFIG, "exists": os.path.exists(PRESENCE_CONFIG),
            "leave_after_s": cfg["leave_after"], "come_after_s": cfg["come_after"],
            "distance_cm": cfg["distance_mm"] / 10 if cfg["distance_mm"] else None,
            "leave": steps("leave"), "come": steps("come"), "leave_run": cfg["leave_run"], "come_run": cfg["come_run"],
            "away_light": shlex.join(cfg["away_light"])}


def macros(kb):
    out = {}
    for n in kb.macro_slots():
        m = kb.read_macro(n)
        length = min(m[62] | m[63] << 8, 967)
        # Bytes 59-61 (run mode, repeat count, time unit) stay unused: the run mode that counts
        # is the one in the key assignment, as Unleash writes it.
        out[str(n)] = {"name": m[9:9 + min(m[8], 50)].decode("utf-8", "replace"),
                       "actions": macro_actions(m[64:64 + length])}
    return out


def backup(kb):
    directory = os.path.join(STATE, "backups", time.strftime("%Y%m%d-%H%M%S"))
    reports = {f"profile-{n}": kb.read_profile(n) for n in range(1, 10)}
    reports["macro-table"] = kb.call(bytes([9, *HEADER, READ, 0, 0, FAIL]), 0.15)
    reports.update({f"macro-{n:03}": kb.read_macro(n) for n in kb.macro_slots()})
    save(directory, reports)
    return directory


def macro_users(kb, n):
    """The keys in profiles 1-9 (either layer) that run macro n."""
    labels = KEY_POSITIONS
    users = []
    for p in range(1, 10):
        profile = kb.read_profile(p)
        for layer, base in (("", P_KEYS), ("Fn+", P_FN_KEYS)):
            for pos in range(121):
                if profile[base + pos * 4] == 3 and profile[base + pos * 4 + 1] == n:
                    users.append(f"profile {p} {layer}{labels.get(pos, f'key {pos}')}")
    return users


def change_macro(kb, v):
    """z20 macro new NAME STEPS | edit N STEPS | rename N NAME | delete N: (number, name, data)."""
    slots = kb.macro_slots()
    if v[0] == "new":
        n = next((m for m in MACRO_SLOTS if m not in slots), None)
        if n is None:
            raise Z20Error("all 100 macro slots are in use")
        name, data = v[1], parse_steps(" ".join(v[2:]))
    else:
        n = int(v[1])
        if n not in slots:
            raise Z20Error(f"no macro {n} on the keyboard (z20 macros lists them)")
        old = kb.read_macro(n)
        name = v[2] if v[0] == "rename" else old[9:9 + min(old[8], MACRO_NAME_MAX)].decode("utf-8", "replace")
        data = parse_steps(" ".join(v[2:])) if v[0] == "edit" else old[64:64 + (old[62] | old[63] << 8)]
    if v[0] in ("new", "rename") and any(kb.macro_name(m) == name for m in slots if m != n):
        raise Z20Error(f"there is a macro \"{name}\" already (Unleash tells macros apart by name)")
    if v[0] == "delete":
        users = macro_users(kb, n)
        if users:
            raise Z20Error(f"macro {n} is on {', '.join(users)}: put something else there first (z20 key)")
        kb.delete_macro(n)
    else:
        kb.write_macro(n, name, data)
    return n, name, data


def restore(kb, directory, profile=None, macro=None):
    """Write profiles and macros back from a backup or previous/: all it holds, or one."""
    if profile or macro:
        files = [f"profile-{profile}.bin" if profile else f"macro-{macro:03}.bin"]
    else:
        files = sorted(os.listdir(directory))
    items = []  # read everything first: writing empties previous/, which may be the directory
    for file in files:
        found = re.fullmatch(r"(profile|macro)-(\d+)\.bin", file)
        path = os.path.join(directory, file)
        if not found:
            continue
        if not os.path.exists(path):
            raise Z20Error(f"no {file} in {directory}")
        with open(path, "rb") as f:
            data = f.read()
        kind, n = found.group(1), int(found.group(2))
        good = (len(data) == SIZES[8] and 1 <= n <= 9) if kind == "profile" else \
               (len(data) == SIZES[9] and n in MACRO_SLOTS and data[1031] == 1)
        if not good or data[1:3] != HEADER or data[4] != n or data[7] != checksum(data):
            raise Z20Error(f"{path} is not a good copy of {kind} {n}")
        items.append((kind, n, data))
    if not items:
        raise Z20Error(f"nothing to restore in {directory}")
    for kind, n, data in items:
        kb.write_profile(n, data) if kind == "profile" else kb.put_macro(n, bytearray(data))
    return [f"{kind} {n}" for kind, n, _ in items]


def main():
    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument("command", choices=("status", "macros", "macro", "profile", "rate", "nkro", "game-mode",
                                            "key", "light", "color", "animate", "backlight", "sensor", "presence",
                                            "events", "backup", "restore"))
    parser.add_argument("values", nargs="*", help="see above")
    parser.add_argument("--profile", type=int, choices=range(1, 10), metavar="N", help="profile 1-9")
    parser.add_argument("--macro", type=int, choices=MACRO_SLOTS, metavar="N", help="restore: only macro N")
    run = parser.add_mutually_exclusive_group()
    run.add_argument("--toggle", action="store_true", help="key macro: run until the key is pressed again")
    run.add_argument("--hold", action="store_true", help="key macro: run while the key is held")
    run.add_argument("--repeat", type=int, choices=range(1, 256), metavar="N", help="key macro: run N times")
    parser.add_argument("--fn", action="store_true", help="key: its Fn layer")
    parser.add_argument("--brightness", type=int, choices=range(0, 101), metavar="P", help="percent")
    parser.add_argument("--cycle", type=int, metavar="MS", help="effect cycle in milliseconds")
    parser.add_argument("--direction", choices=("up", "down", "left", "right", "cw", "ccw"),
                        help="light wave / spiral: which way it runs")
    parser.add_argument("--live", action="store_true", help="light: in RAM only, until z20 light reload; "
                                                             "animate: for now, as the service")
    parser.add_argument("--save", action="store_true", help="animate: as the service, also after the next login")
    parser.add_argument("--dry-run", action="store_true", help="presence: say what it would do instead")
    parser.add_argument("--wait", type=float, metavar="S", help="events: only the first within S seconds")
    parser.add_argument("--json", action="store_true", help="print as JSON")
    args = parser.parse_intermixed_args()  # options may also stand between the values
    v = args.values
    number = lambda s: re.fullmatch(r"[1-9]", s) is not None
    if args.command == "profile" and v and not (len(v) == 1 and number(v[0]) or
                                          len(v) == 3 and v[0] == "rename" and number(v[1]) or
                                          len(v) == 3 and v[0] == "copy" and number(v[1]) and number(v[2])
                                          and v[1] != v[2]):
        parser.error("profile N | profile rename N NAME | profile copy N M (1-9)")
    if args.command == "game-mode":
        if v[:1] == ["keys"]:
            names = [n for part in v[1:] for n in part.lower().split(",") if n]
            if names != ["none"] and any(n not in GAME_KEYS for n in names):
                parser.error(f"game-mode keys: {', '.join(GAME_KEYS)}, or none")
        elif len(v) != 1 or v[0] not in ("on", "off", "toggle"):
            parser.error("game-mode needs on, off, toggle, or keys")
    if args.command == "rate" and (len(v) > 1 or v and not (v[0].isdigit() and int(v[0]) in RATES)):
        parser.error("rate: 1000, 2000 or 4000")
    if args.command == "nkro" and (len(v) != 1 or v[0] not in ("on", "off")):
        parser.error("nkro: on or off")
    if args.live and args.command != "animate" and (args.command != "light" or not v or v[0] in ("reload", "default")
                                                    or args.profile):
        parser.error("--live: for z20 light EFFECT, on the active profile, and z20 animate EFFECT | off")
    if args.command == "animate":
        if v and v[0] not in (*ANIMATIONS, "off", "reload", "saved"):
            parser.error(f"animate: one of {', '.join(ANIMATIONS)}, or off, reload")
        if v and v[0] in ANIMATIONS:
            try:
                check_animation(v[0], [c.lstrip("#") for c in v[1:]], args.cycle, args.brightness)
            except Z20Error as e:
                parser.error(str(e))
        elif len(v) > 1:
            parser.error(f"animate {v[0]} takes no more values")
        if args.save and args.live or args.save and not (v and v[0] in ANIMATIONS) \
                or args.live and not (v and (v[0] in ANIMATIONS or v[0] == "off")):
            parser.error("animate: --save or --live, with an effect (--live also with off)")
    if args.command == "backlight" and not (len(v) <= 1 and (not v or v[0] in ("run", "up", "down")
                                                            or v[0].isdigit() and int(v[0]) <= 100)):
        parser.error("backlight: P (percent, 0-100), up, down, or run")
    if args.command == "color" and v and v != ["off"] and (len(v) % 2 or not v):
        parser.error("color: LEDS COLOR pairs, like: color w,a,s,d ff0000 all 000000; or color off")
    if args.command == "light" and v and v not in (["reload"], ["default"]):
        if v[0] not in EFFECTS:
            parser.error(f"light: one of {', '.join(EFFECTS)}, or reload, default")
        most = EFFECT_COLORS.get(EFFECTS[v[0]], (0, 0, 0))[1]  # without colors: the ones the profile keeps
        if len(v) - 1 > most:
            parser.error(f"light {v[0]}: " + (f"at most {most} color{'s' if most > 1 else ''}" if most
                                              else "takes no colors"))
        if args.direction and args.direction not in DIRECTIONS.get(EFFECTS[v[0]], {}):
            parser.error("--direction: up, down, left or right for wave, cw or ccw for spiral")
    if args.command == "key":
        if not v:
            parser.error("key: which key (e1, capslock, f1, a ...), or all")
        if v[0].lower() == "all" and (v[1:] != ["default"] or args.fn):
            parser.error("key all: only 'key all default' (every key back to the factory setting)")
        if (args.toggle or args.hold or args.repeat) and v[1:2] != ["macro"]:
            parser.error("--toggle, --hold and --repeat are for macros")
    if args.command == "macro":
        least = {"new": 3, "edit": 3, "rename": 3, "delete": 2}
        if not v or v[0] not in least or len(v) < least[v[0]] or v[0] in ("rename", "delete") and len(v) != least[v[0]]:
            parser.error("macro new NAME STEPS | edit N STEPS | rename N NAME | delete N")
        if v[0] != "new" and not (v[1].isdigit() and int(v[1]) in MACRO_SLOTS):
            parser.error("macro: a number 1-100 (z20 macros lists them)")
        name = {"new": v[1], "rename": v[-1]}.get(v[0])
        if name is not None and not 0 < len(name.encode()) <= MACRO_NAME_MAX:
            parser.error(f"macro name: 1 to {MACRO_NAME_MAX} bytes")
    if args.command == "restore" and len(v) != 1:
        parser.error("restore needs a backup directory")

    if args.command == "presence" and v[:1] == ["set"]:
        if len(v) < 3 or len(v) % 2 == 0:
            parser.error("presence set KEY VALUE [KEY VALUE ...] (keys: " + ", ".join(PRESENCE_DEFAULTS) + ")")
        set_presence([(v[i].lower().replace("-", " "), v[i + 1]) for i in range(1, len(v), 2)])
        systemctl("try-restart", "z20-presence.service")  # a running service goes by the new settings
        v = ["settings"]
    if args.command == "presence" and v == ["settings"]:
        s = presence_settings()
        if args.json:
            print(json.dumps(s))
        else:
            steps = lambda event: ", ".join(a["action"] + (f" after {a['after_s']:g} s" if a["after_s"] else "")
                                            for a in s[event]) or "nothing"
            print(f"{s['config']}{'' if s['exists'] else ' (not there: the defaults)'}:\n"
                  f"  away for {s['leave_after_s']:g} s: {steps('leave')}"
                  f"{'; lighting: ' + s['away_light'] if s['away_light'] else ''}\n"
                  f"  back for {s['come_after_s']:g} s: {steps('come')}"
                  f"{'; the stored lighting' if s['away_light'] else ''}")
        return 0
    if args.command == "animate":
        try:
            state = animate_command(v, args)
        except KeyboardInterrupt:
            return 0
        if not v or v[0] in ("off", "reload") or args.save or args.live:
            print(json.dumps(state and {k: state[k] for k in ("effect", "colors", "cycle_ms", "brightness", "how")})
                  if args.json else animation_text(state))
        return 0
    if args.command == "backlight":
        if v == ["run"]:
            try:
                backlight()
            except KeyboardInterrupt:
                pass
            return 0
        if v:
            set_backlight(v[0])
        info = backlight_info()
        if args.json or not v or sys.stdout.isatty():
            print(json.dumps(info) if args.json else backlight_text(info))
        return 0
    if args.command in ("presence", "events"):
        if v:
            parser.error(f"{args.command} takes no values" + (" but settings, set" if args.command == "presence" else ""))
        try:
            presence(args.dry_run) if args.command == "presence" else watch_events(args.json, args.wait)
        except KeyboardInterrupt:
            pass
        return 0

    kb = Keyboard()
    try:
        if args.command == "status":
            s = status(kb)
            if args.json:
                print(json.dumps(s))
            else:
                print(f"EVGA {s['model']}, firmware {s['firmware']}: profile {s['profile']} \"{s['profile_name']}\", "
                      f"Game Mode {'on' if s['game_mode'] else 'off'} (blocks {', '.join(s['game_mode_blocks']) or 'nothing'}), "
                      f"{'NKRO' if s['nkro'] else '6KRO'}, {s['report_rate']} Hz")
                print(f"lighting: {lighting_text(s['lighting'])}"
                      + (f"; over it: {animation_text(s['animation'])}" if s["animation"] else "")
                      + (f"; dimmed to {s['backlight']['shown']} % (z20 backlight)" if s["backlight"]["shown"] < 100 else ""))
                for label, key in s["keys"].items():
                    print(f"{label:7} {key['text']}")
                if s["changed_keys"]:
                    print("other keys, changed from the factory setting:")
                    for label, key in s["changed_keys"].items():
                        print(f"  {label:12} {key['text']}")
                on_keys = [*s["keys"].values(), *s["changed_keys"].values()]
                unused = [f"{m} \"{name}\"" for m, name in s["macros"].items()
                          if not any(k.get("macro") == int(m) for k in on_keys)]
                if unused:
                    print(f"macros on no key: {', '.join(unused)}")
        elif args.command == "macros":
            ms = macros(kb)
            if args.json:
                print(json.dumps(ms))
            for n, m in ([] if args.json else ms.items()):
                print(f"{n:>3} \"{m['name']}\"")
                print("      " + ", ".join(m["actions"]))
        elif args.command == "macro":
            n, name, data = change_macro(kb, v)
            if v[0] == "delete":
                print(json.dumps({"macro": n, "deleted": True}) if args.json else f"deleted macro {n}")
            else:
                steps = macro_actions(data)
                print(json.dumps({"macro": n, "name": name, "actions": steps}) if args.json
                      else f"macro {n} \"{name}\": {', '.join(steps)}")
        elif args.command == "profile" and v[:1] in (["rename"], ["copy"]):
            n = int(v[1]) if v[0] == "rename" else int(v[2])
            if v[0] == "rename":
                p = set_profile_name(kb.read_profile(n), v[2])
            else:  # all of N, but M keeps its name
                p = bytearray(kb.read_profile(int(v[1])))
                p[P_NAME_LEN:P_NAME + 126] = kb.read_profile(n)[P_NAME_LEN:P_NAME + 126]
            kb.write_profile(n, p)
            if args.json or sys.stdout.isatty():
                print(json.dumps({"profile": n, "name": profile_name(p)}) if args.json
                      else f"profile {n}: \"{profile_name(p)}\"" + (f", now with profile {v[1]}'s settings"
                                                                        if v[0] == "copy" else ""))
        elif args.command == "profile" and not v:
            active = kb.profile_number()
            ps = [{"profile": n, "name": profile_name(kb.read_profile(n)), "active": n == active} for n in range(1, 10)]
            print(json.dumps(ps) if args.json else
                  "\n".join(f"{'*' if p['active'] else ' '} {p['profile']}  {p['name']}" for p in ps))
        elif args.command == "profile":
            kb.set_profile(int(v[0]))
        elif args.command == "rate":
            n = args.profile or kb.profile_number()
            p = kb.read_profile(n)
            if v:
                p = bytearray(p)
                p[P_RATE] = RATES[int(v[0])]
                kb.write_profile(n, p)
            if args.json or not v or sys.stdout.isatty():
                print(json.dumps({"profile": n, "report_rate": rate_hz(p)}) if args.json
                      else f"profile {n}: {rate_hz(p)} Hz")
        elif args.command == "nkro":
            kb.set_nkro(v[0] == "on")
            if args.json or sys.stdout.isatty():
                on = kb.nkro()
                print(json.dumps({"nkro": on}) if args.json else "NKRO" if on else "6KRO")
        elif args.command == "game-mode" and v[0] == "keys":
            n = args.profile or kb.profile_number()
            p = kb.read_profile(n)
            if v[1:]:
                names = [x for part in v[1:] for x in part.lower().split(",") if x]
                p = set_game_keys(p, [] if names == ["none"] else names)
                kb.write_profile(n, p)
            if args.json or len(v) == 1 or sys.stdout.isatty():
                blocked = game_keys(p)
                print(json.dumps({"profile": n, "game_mode_blocks": blocked}) if args.json
                      else f"profile {n}: Game Mode blocks {', '.join(blocked) or 'nothing'}")
        elif args.command == "game-mode":
            kb.set_game_mode(not kb.game_mode() if v[0] == "toggle" else v[0] == "on")
            if args.json or sys.stdout.isatty():
                on = kb.game_mode()
                print(json.dumps({"game_mode": on}) if args.json else f"Game Mode {'on' if on else 'off'}")
        elif args.command == "key" and v[0].lower() == "all":
            n = args.profile or kb.profile_number()
            kb.write_profile(n, reset_keys(kb.read_profile(n), kb.read_profile(DEFAULT_PROFILE)))
            print(json.dumps({"profile": n, "keys": "default"}) if args.json
                  else f"profile {n}: every key as from the factory (Win and Fn as they were), macros kept")
        elif args.command == "key":
            n = args.profile or kb.profile_number()
            pos = key_target(v[0], args.fn)
            label = ("Fn+" if args.fn else "") + KEY_POSITIONS[pos]
            at = (P_FN_KEYS if args.fn else P_KEYS) + pos * 4
            p = kb.read_profile(n)
            if len(v) > 1:
                if v[1:] == ["default"]:
                    function = kb.read_profile(DEFAULT_PROFILE)[at:at + 4]
                else:
                    # once: mode 9; N times: mode 11, which runs once more than its count
                    times = args.repeat or 1
                    run = (8, 0) if args.toggle else (12, 0) if args.hold else (9, 0) if times == 1 else (11, times - 1)
                    function = parse_function(v[1:], kb.macro_slots() if v[1] == "macro" else [], run)
                p = bytearray(p)
                p[at:at + 4] = function
                kb.write_profile(n, p)
            b = p[at:at + 4]
            names = {b[1]: kb.macro_name(b[1])} if b[0] == 3 and b[1] in kb.macro_slots() else {}
            text, info = key_function(b, names)
            if args.json:
                print(json.dumps({"profile": n, "key": label, "text": text, **info}))
            elif len(v) == 1 or sys.stdout.isatty():
                print(f"profile {n}: {label} {text}")
        elif args.command == "light":
            active = kb.profile_number()
            n = args.profile or active
            if v == ["reload"]:
                kb.general(0x08, WRITE, wait=0.1)  # RAM from flash: the stored lighting again
            p = kb.read_profile(n)
            stored = lighting(p)
            if v == ["default"]:
                p = from_factory(p, kb.read_profile(DEFAULT_PROFILE), FACTORY_LIGHTING)
                kb.write_profile(n, p)
                stored = lighting(p)
            elif v and v != ["reload"]:
                colors = fill_colors(v[0], [parse_color(c) for c in v[1:]])
                if args.live:
                    p = live_lighting(kb, v[0], colors, args.brightness, args.cycle, args.direction)
                else:
                    p = set_lighting(p, v[0], colors, args.brightness, args.cycle, args.direction)
                    kb.write_profile(n, p)
                    stored = lighting(p)
            elif n == active:  # what is shown: RAM, which --live may have changed
                p = with_ram_lighting(kb, p, kb.read_ram(RAM_EFFECT)[0])
            state = {"profile": n, **lighting(p)}
            if n == active and state != {"profile": n, **stored}:
                state.update(live=True, stored=stored)
            if n == active:  # what is shown: z20 backlight may dim it
                state["backlight_percent"] = backlight_percent()
            if args.json:
                print(json.dumps(state))
            elif not v or v == ["reload"] or sys.stdout.isatty():
                print(f"profile {n}: {lighting_text(state)}" +
                      (f" (live; stored: {lighting_text(stored)})" if state.get("live") else "") +
                      (f", dimmed to {state['backlight_percent']} % (z20 backlight)"
                       if state.get("backlight_percent", 100) < 100 else ""))
        elif args.command == "color":
            frame = None
            if v == ["off"]:
                kb.send(bytes([6, *HEADER, 0]))  # stop: the profile's lighting again
                if os.path.exists(COLORS):
                    os.remove(COLORS)
            else:
                if os.path.exists(COLORS):
                    with open(COLORS, "rb") as f:
                        frame = f.read()
                if v:
                    frame = color_frame(frame, list(zip(v[::2], v[1::2])), args.brightness)
                    kb.send(color_report(dimmed_frame(frame, backlight_percent())))
                    save(STATE, {"colors": frame})
            shown = colors_shown(frame) if frame else {}
            if args.json:
                print(json.dumps({"on": frame is not None, "colors": shown}))
            elif not v or sys.stdout.isatty():
                if frame is None:
                    print("per-key colors: off (the profile's lighting shows)")
                for color, names in shown.items():
                    print(f"{color}  {', '.join(names)}")
        elif args.command == "sensor" and v[:1] == ["watch"]:
            kb.close()  # watch takes the keyboard only for each reading
            kb = None
            watch_sensor(args.json)
        elif args.command == "sensor":
            n = args.profile or kb.profile_number()
            p = kb.read_profile(n)
            if v:
                p = from_factory(p, kb.read_profile(DEFAULT_PROFILE), FACTORY_SENSOR) if v == ["default"] \
                    else set_sensor(p, v)
                kb.write_profile(n, p)
            s = {"profile": n, **sensor_settings(p)}
            if n == kb.profile_number():  # what it measures now; without anything in view the distance means nothing
                s["distance_mm"], s["seen"] = kb.distance()
                s["in_view"] = in_view(s["seen"])
            if args.json:
                print(json.dumps(s))
            elif not v or sys.stdout.isatty():
                print(f"profile {n}: {sensor_text(s)}" + ("" if "distance_mm" not in s else
                      f"; now {s['distance_mm']} mm" if s["in_view"] else "; now nothing in view"))
        elif args.command == "backup":
            print(backup(kb))
        elif args.command == "restore":
            print("restored " + ", ".join(restore(kb, os.path.expanduser(v[0]), args.profile, args.macro)))
    finally:
        if kb:
            kb.close()
    return 0


if __name__ == "__main__":
    try:
        sys.exit(main())
    except Z20Error as e:
        sys.exit(f"z20: {e}")
