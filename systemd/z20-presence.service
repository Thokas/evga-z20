[Unit]
Description=EVGA Z20 presence: act on the desktop when you leave and come back
Documentation=https://github.com/Thokas/evga-z20
PartOf=graphical-session.target
After=graphical-session.target

[Service]
ExecStart=%h/.local/bin/z20 presence
Restart=on-failure
RestartSec=10

[Install]
WantedBy=graphical-session.target
