[Unit]
Description=EVGA Z20 software lighting effect (z20 animate)
Documentation=https://github.com/Thokas/evga-z20
PartOf=graphical-session.target
After=graphical-session.target

[Service]
# Runs the effect saved with z20 animate ... --save (~/.config/z20/animation.ini), or the
# one started with --live; without either it ends at once.
ExecStart=%h/.local/bin/z20 animate saved
Restart=on-failure
RestartSec=10

[Install]
WantedBy=graphical-session.target
