#!/usr/bin/env python3
"""A stand-in for z20 in a test's home: each run logged ($HOME/z20.log), the status from
$HOME/status.json, the sensor settings from $HOME/sensor.json if there, nine profiles as from the
factory, z20 leds from the real z20 ($Z20_REPO/z20: it needs no keyboard), anything else null."""
import json
import os
import sys

home = os.environ["HOME"]
args = sys.argv[1:]
with open(os.path.join(home, "z20.log"), "a") as f:
    f.write(" ".join(args) + "\n")
command = args[0] if args else ""
if command == "leds":
    os.execv(sys.executable, [sys.executable, "-I", os.path.join(os.environ["Z20_REPO"], "z20"), *args])
elif command == "status":
    path = os.path.join(home, "status.json")
    if not os.path.exists(path):
        sys.exit("z20: no EVGA Z20 connected")
    with open(path) as f:
        print(json.dumps(json.load(f)))
elif command == "sensor" and os.path.exists(os.path.join(home, "sensor.json")):
    with open(os.path.join(home, "sensor.json")) as f:
        print(json.dumps(json.load(f)))
elif command == "profile":
    print(json.dumps([{"profile": n, "name": f"DEFAULT {n}", "active": n == 1} for n in range(1, 10)]))
else:
    print("null")
